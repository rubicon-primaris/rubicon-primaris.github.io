---
// Mapa galáctico interactivo (port del diseño "Mapa Galactico.dc.html" de Claude Design).
// mode="page": ocupa el contenedor y la rueda siempre hace zoom (página /mapa).
// mode="embed": incrustado en otra página; la rueda solo hace zoom tras un clic,
// y la cabecera enlaza a la versión a pantalla completa.
const { mode = 'page' } = Astro.props
---
<div id="gm-root" style="position:absolute;inset:0">
  <div id="gm-vp" data-wheel={mode === 'embed' ? 'click' : 'always'} style="position:absolute;inset:0;background:radial-gradient(ellipse at center,#060809 0%,#000000 75%);overflow:hidden;cursor:grab;perspective:1100px;user-select:none;-webkit-user-select:none">
    <div id="gm-world" style="position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d">
      <div id="gm-disc" class="gm-spin" style="position:absolute;left:-248px;top:-430px;width:1080px;height:848px;transform-origin:248px 430px;transform-style:preserve-3d">
        <div style="position:absolute;left:160px;top:130px;width:800px;height:600px;border-radius:50%;background:radial-gradient(ellipse,rgba(130,160,170,0.11) 0%,rgba(130,160,170,0.04) 45%,transparent 70%)"></div>
        <div style="position:absolute;left:180px;top:300px;width:760px;height:260px;border-radius:50%;background:radial-gradient(ellipse,rgba(120,160,170,0.08),transparent 70%);transform:rotate(33deg);filter:blur(16px)"></div>
        <div style="position:absolute;left:180px;top:300px;width:760px;height:260px;border-radius:50%;background:radial-gradient(ellipse,rgba(120,150,170,0.07),transparent 70%);transform:rotate(123deg);filter:blur(16px)"></div>
        <div style="position:absolute;left:410px;top:310px;width:300px;height:240px;border-radius:50%;background:radial-gradient(ellipse,rgba(225,234,238,0.16),transparent 68%);filter:blur(8px)"></div>
        <div style="position:absolute;left:163px;top:345px;width:170px;height:170px;border-radius:50%;background:repeating-conic-gradient(rgba(255,255,255,0.16) 0deg 0.5deg,transparent 0.5deg 4deg);-webkit-mask-image:radial-gradient(circle,rgba(0,0,0,0.9) 0%,transparent 66%);mask-image:radial-gradient(circle,rgba(0,0,0,0.9) 0%,transparent 66%)"></div>
        <div style="position:absolute;left:220px;top:402px;width:56px;height:56px;border-radius:50%;background:radial-gradient(circle,rgba(255,250,235,0.5),transparent 70%)"></div>
        <svg id="gm-stars" width="1080" height="848" viewBox="0 0 1080 848" style="position:absolute;left:0;top:0;pointer-events:none"></svg>
        <svg width="1080" height="848" viewBox="0 0 1080 848" style="position:absolute;left:0;top:0;pointer-events:none;transform:translateZ(0);will-change:transform">
          <defs>
            <linearGradient id="riftG" x1="0" y1="0" x2="1" y2="0.5"><stop offset="0%" stop-color="#b3402f" stop-opacity="0.7"></stop><stop offset="45%" stop-color="#c13a6b" stop-opacity="0.85"></stop><stop offset="100%" stop-color="#8a1f4a" stop-opacity="0.65"></stop></linearGradient>
            <radialGradient id="stormG"><stop offset="0%" stop-color="#1c0510"></stop><stop offset="40%" stop-color="#7a1c42" stop-opacity="0.85"></stop><stop offset="72%" stop-color="#b3402f" stop-opacity="0.4"></stop><stop offset="100%" stop-color="#b3402f" stop-opacity="0"></stop></radialGradient>
            <filter id="chA" x="-30%" y="-30%" width="160%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="0.011 0.032" numOctaves="4" seed="11" result="n"></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="70"></feDisplacementMap><feGaussianBlur stdDeviation="4"></feGaussianBlur></filter>
            <filter id="chB" x="-30%" y="-30%" width="160%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="0.018 0.045" numOctaves="4" seed="23" result="n"></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="42"></feDisplacementMap><feGaussianBlur stdDeviation="1.6"></feGaussianBlur></filter>
            <filter id="chC" x="-25%" y="-25%" width="150%" height="150%"><feTurbulence type="fractalNoise" baseFrequency="0.03 0.06" numOctaves="3" seed="41" result="n"></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="26"></feDisplacementMap><feGaussianBlur stdDeviation="0.8"></feGaussianBlur></filter>
          </defs>
          <path d="M248,430 C310,300 440,180 620,10" fill="none" stroke="#7a3430" stroke-width="0.9" opacity="0.45"></path>
          <path d="M248,430 C180,400 90,350 0,305" fill="none" stroke="#7a3430" stroke-width="0.9" opacity="0.45"></path>
          <path d="M248,430 C200,560 130,700 60,848" fill="none" stroke="#7a3430" stroke-width="0.9" opacity="0.45"></path>
          <path d="M248,430 C400,560 560,700 700,848" fill="none" stroke="#7a3430" stroke-width="0.9" opacity="0.45"></path>
          <circle cx="248" cy="430" r="168" fill="none" stroke="#7a3430" stroke-width="0.8" opacity="0.4" stroke-dasharray="3 5"></circle>
          <ellipse cx="185" cy="255" rx="82" ry="70" fill="#c13a6b" opacity="0.22" filter="url(#chA)"></ellipse>
          <ellipse cx="150" cy="310" rx="50" ry="38" fill="#b3402f" opacity="0.18" filter="url(#chA)"></ellipse>
          <ellipse cx="345" cy="300" rx="38" ry="24" fill="#c13a6b" opacity="0.2" filter="url(#chB)"></ellipse>
          <ellipse cx="470" cy="618" rx="62" ry="40" fill="#c13a6b" opacity="0.18" filter="url(#chA)"></ellipse>
          <ellipse cx="880" cy="620" rx="92" ry="72" fill="#c13a6b" opacity="0.2" filter="url(#chA)"></ellipse>
          <ellipse cx="915" cy="725" rx="70" ry="78" fill="#8a1f4a" opacity="0.22" filter="url(#chA)"></ellipse>
          <ellipse cx="830" cy="700" rx="58" ry="48" fill="#b3402f" opacity="0.16" filter="url(#chA)"></ellipse>
          <ellipse cx="830" cy="55" rx="62" ry="34" fill="#c13a6b" opacity="0.2" filter="url(#chA)"></ellipse>
          <ellipse cx="935" cy="285" rx="36" ry="25" fill="#c13a6b" opacity="0.18" filter="url(#chB)"></ellipse>
          <path d="M130,205 C240,255 300,320 400,360 C500,400 560,420 640,455 C740,498 880,560 995,650" fill="none" stroke="url(#riftG)" stroke-width="62" stroke-linecap="round" opacity="0.3" filter="url(#chA)"></path>
          <path d="M130,205 C240,255 300,320 400,360 C500,400 560,420 640,455 C740,498 880,560 995,650" fill="none" stroke="#c13a6b" stroke-width="32" stroke-linecap="round" opacity="0.42" filter="url(#chB)"></path>
          <path d="M130,205 C240,255 300,320 400,360 C500,400 560,420 640,455 C740,498 880,560 995,650" fill="none" stroke="#160410" stroke-width="15" stroke-linecap="round" opacity="0.95" filter="url(#chC)"></path>
          <path d="M130,205 C240,255 300,320 400,360 C500,400 560,420 640,455 C740,498 880,560 995,650" fill="none" stroke="#e07898" stroke-width="1.6" opacity="0.3" filter="url(#chB)"></path>
          <ellipse cx="600" cy="430" rx="92" ry="56" fill="#05070a" opacity="0.9" filter="url(#chB)"></ellipse>
          <ellipse cx="520" cy="392" rx="42" ry="27" fill="#05070a" opacity="0.85" filter="url(#chC)"></ellipse>
          <ellipse cx="680" cy="470" rx="52" ry="31" fill="#05070a" opacity="0.85" filter="url(#chC)"></ellipse>
          <ellipse cx="430" cy="362" rx="30" ry="19" fill="#05070a" opacity="0.8" filter="url(#chC)"></ellipse>
          <ellipse cx="300" cy="312" rx="26" ry="16" fill="#05070a" opacity="0.8" filter="url(#chC)"></ellipse>
          <ellipse cx="760" cy="512" rx="35" ry="22" fill="#05070a" opacity="0.8" filter="url(#chC)"></ellipse>
          <ellipse cx="878" cy="582" rx="40" ry="26" fill="#05070a" opacity="0.85" filter="url(#chC)"></ellipse>
          <ellipse cx="958" cy="642" rx="30" ry="20" fill="#05070a" opacity="0.8" filter="url(#chC)"></ellipse>
          <circle cx="176" cy="215" r="38" fill="url(#stormG)" filter="url(#chB)"></circle>
          <ellipse cx="176" cy="215" rx="15" ry="10" fill="#0a0208" filter="url(#chC)" opacity="0.95"></ellipse>
          <circle cx="523" cy="468" r="42" fill="url(#stormG)" filter="url(#chB)"></circle>
          <ellipse cx="523" cy="468" rx="17" ry="11" fill="#0a0208" filter="url(#chC)" opacity="0.95"></ellipse>
          <circle cx="516" cy="131" r="27" fill="url(#stormG)" filter="url(#chB)"></circle>
          <circle cx="428" cy="633" r="27" fill="url(#stormG)" filter="url(#chB)"></circle>
          <circle cx="905" cy="630" r="23" fill="url(#stormG)" filter="url(#chB)"></circle>
          <circle cx="935" cy="272" r="18" fill="url(#stormG)" filter="url(#chB)"></circle>
          <circle cx="782" cy="72" r="15" fill="url(#stormG)" filter="url(#chB)"></circle>
          <path d="M830,565 L945,555 L985,655 L940,735 L845,712 L815,630 Z" fill="rgba(143,208,200,0.05)" stroke="#8fd0c8" stroke-width="1" stroke-dasharray="5 4" opacity="0.6"></path>
          <path d="M675,690 L775,682 L800,765 L745,808 L672,775 Z" fill="rgba(143,191,90,0.05)" stroke="#8fbf5a" stroke-width="1" stroke-dasharray="4 4" opacity="0.5"></path>
        </svg>
        <div id="gm-regions"></div>
        <div id="gm-nodes"></div>
      </div>
    </div>

    <header style="position:absolute;left:28px;top:24px;pointer-events:none">
      <div style="pointer-events:auto;display:flex;gap:18px">
        {mode === 'embed' ? (
          <a href="/mapa" style="font-size:11px;letter-spacing:0.2em">⛶ PANTALLA COMPLETA</a>
        ) : (
          <>
            <a href="/genealogia" style="font-size:11px;letter-spacing:0.2em">← GENEALOGÍA ASTARTES</a>
            <a href="/" style="font-size:11px;letter-spacing:0.2em">PORTADA</a>
          </>
        )}
      </div>
      <h1 style="font-family:'Cinzel',serif;font-size:26px;font-weight:700;letter-spacing:0.1em;color:#ffffff;margin:10px 0 4px">LA GALAXIA · M42</h1>
      <div style="font-size:11px;letter-spacing:0.24em;color:#8a8a92">IMPERIUM SANCTUS · IMPERIUM NIHILUS</div>
    </header>

    <div style="position:absolute;right:24px;top:24px;display:flex;gap:8px">
      <button id="gm-zout" title="Alejar" class="gm-hb" style="cursor:pointer;font-size:15px;width:36px;height:32px;border:1px solid #34343c;background:rgba(8,8,9,0.8);color:#e8e6e0;border-radius:2px">−</button>
      <button id="gm-zin" title="Acercar" class="gm-hb" style="cursor:pointer;font-size:15px;width:36px;height:32px;border:1px solid #34343c;background:rgba(8,8,9,0.8);color:#e8e6e0;border-radius:2px">+</button>
      <button id="gm-zfit" class="gm-hb" style="cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:0.12em;padding:0 14px;height:32px;border:1px solid #34343c;background:rgba(8,8,9,0.8);color:#e8e6e0;border-radius:2px">AJUSTAR</button>
      <button id="gm-play" class="gm-hb" style="cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:0.12em;padding:0 14px;height:32px;border:1px solid #34343c;background:rgba(8,8,9,0.8);color:#e8e6e0;border-radius:2px">❚❚ ÓRBITA</button>
    </div>

    <div style="position:absolute;left:28px;bottom:24px;display:flex;flex-direction:column;gap:6px;font-size:10.5px;color:#8a8a92;letter-spacing:0.08em;background:rgba(0,0,0,0.5);padding:12px 14px;border:1px solid #1c1c22;border-radius:2px">
      <span style="display:flex;align-items:center;gap:9px"><span style="width:10px;height:10px;border-radius:50%;background:radial-gradient(circle,#ffffff 30%,transparent 75%);box-shadow:0 0 8px 2px rgba(255,244,214,0.5)"></span>Trono / capital</span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:10px;height:10px;border-radius:50%;border:1px solid #dfe3e6;display:flex;align-items:center;justify-content:center"><span style="width:4px;height:4px;border-radius:50%;background:#ffffff"></span></span>Mundo capitular Astartes</span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:6px;height:6px;border-radius:50%;background:#cfd6da;margin:0 2px"></span>Mundo imperial</span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:9px;height:9px;border-radius:50%;border:1px dashed #c14a72;background:rgba(193,58,107,0.15)"></span><span style="color:#d97a9a">Fenómeno warp / Caos</span></span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:8px;height:8px;border:1px solid #8fd0c8;background:rgba(143,208,200,0.2);transform:rotate(45deg);margin:0 1px"></span><span style="color:#8fd0c8">Dominio xenos</span></span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:8px;height:8px;border-radius:2px;border:1px solid #8fbf5a;background:rgba(143,191,90,0.2);margin:0 1px"></span><span style="color:#a5c97a">Imperio orko</span></span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:8px;height:8px;border:1px solid #9fb8a8;background:rgba(159,184,168,0.15);margin:0 1px"></span><span style="color:#b8ccbf">Dinastía necrona</span></span>
      <span style="display:flex;align-items:center;gap:9px"><span style="width:8px;height:8px;border-radius:50%;border:1px solid #8a8a92;margin:0 1px"></span>Mundo muerto / destruido</span>
    </div>

    <div style="position:absolute;right:24px;bottom:24px;font-size:10px;color:#55555c;text-align:right;line-height:1.6;max-width:320px"><span id="gm-lod" style="color:#8a8a92"></span><br />Arrastra para desplazarte · rueda para zoom · click en un mundo<br />Mapa no oficial creado por fans · Warhammer 40,000 © Games Workshop</div>

    {mode === 'embed' && (
      <div id="gm-hint" style="position:absolute;left:50%;bottom:20px;transform:translateX(-50%);pointer-events:none;font-size:10.5px;letter-spacing:0.18em;color:#c8c6c0;background:rgba(8,8,9,0.75);border:1px solid #34343c;border-radius:2px;padding:8px 16px;transition:opacity .4s;white-space:nowrap">HAZ CLIC PARA ACTIVAR EL ZOOM CON LA RUEDA</div>
    )}

    <div id="gm-modal" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,0.72);align-items:center;justify-content:center;z-index:50;backdrop-filter:blur(3px)">
      <div id="gm-modal-card" style="width:min(460px,90vw);background:#0c0d10;border:1px solid #34343c;border-radius:3px;padding:28px;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.8)"></div>
    </div>
  </div>
</div>

<style is:global>
  #gm-root a { color: #c8c6c0; text-decoration: none }
  #gm-root a:hover { color: #ffffff }
  #gm-root .gm-hb:hover { border-color: #ffffff !important }
  #gm-root .gm-node { transition: opacity .4s }
  #gm-root .gm-node:hover { opacity: 1 !important }
  #gm-root .gm-region { transition: opacity .4s }
  #gm-root .gm-x { position: absolute; right: 12px; top: 12px; cursor: pointer; background: transparent; border: none; color: #8a8a92; font-size: 17px }
  #gm-root .gm-x:hover { color: #ffffff }
  /* El plano rotado del disco gana el hit-test 3D a sus hijos: se desactiva entero
     y solo los nodos (via JS segun LOD) vuelven a recibir clics */
  #gm-disc { pointer-events: none }
  #gm-root .gm-spin { animation: gmspin 420s linear infinite }
  #gm-root .gm-spinrev { animation: gmspinrev 420s linear infinite }
  #gm-vp.gm-paused .gm-spin, #gm-vp.gm-paused .gm-spinrev { animation-play-state: paused }
  @keyframes gmspin { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }
  @keyframes gmspinrev { from { transform: rotate(0deg) } to { transform: rotate(-360deg) } }
</style>

<script>
  // Port a JS vanilla del diseño "Mapa Galactico.dc.html" (Claude Design)
  const TILT = 48 // inclinación del plano galáctico (grados)

  // t: 0 siempre visible, 1 zoom medio, 2 zoom alto
  const WORLDS = [
    { name: 'Sagrada Terra', x: 244, y: 428, k: 'capital', t: 0, type: 'Mundo Trono', seg: 'Solar', fac: 'Imperium', blurb: 'Corazón del Imperio y sede del Trono Dorado. Desde el Palacio Imperial, la luz del Astronomican guía toda travesía por el warp, y en sus salones el Emperador vela por la humanidad desde hace diez mil años.' },
    { name: 'Marte', x: 272, y: 448, k: 'world', t: 1, type: 'Mundo Forja', seg: 'Solar', fac: 'Adeptus Mechanicus', blurb: 'Dominio del Adeptus Mechanicus y forja primigenia del Imperio. Sus fábricas-catedral producen desde bólters hasta titanes, y bajo su superficie duermen secretos de la Era Oscura de la Tecnología.' },
    { name: 'Ojo del Terror', x: 176, y: 215, k: 'warp', t: 0, type: 'Tormenta warp', seg: 'Obscurus', fac: 'Caos', blurb: 'Herida permanente entre la disformidad y la realidad, nacida de la Caída de los Aeldari. Desde la Herejía es el refugio de las legiones traidoras y el punto de partida de las Cruzadas Negras.' },
    { name: 'Cadia', x: 196, y: 256, k: 'dead', t: 0, type: 'Mundo Fortaleza · destruido', seg: 'Obscurus', fac: 'Imperium (perdido)', blurb: 'Durante diez milenios guardó la Puerta Cadiana, la única ruta estable desde el Ojo del Terror. Fue destruido por Abaddon en la 13ª Cruzada Negra (999.M41). Sus supervivientes repiten un juramento: Cadia resiste.' },
    { name: 'Vigilus', x: 222, y: 302, k: 'world', t: 1, type: 'Mundo Centinela', seg: 'Obscurus', fac: 'Imperium', blurb: 'Guardián del Pasaje de Nachmund, una de las pocas rutas estables a través de la Gran Grieta. Por ello es uno de los mundos más disputados del Imperium Nihilus.' },
    { name: 'Fenris', x: 345, y: 294, k: 'astartes', t: 0, type: 'Mundo Capitular', seg: 'Obscurus', fac: 'Lobos Espaciales', blurb: 'Mundo de hielo cuyos mares se tragan continentes cada invierno. De sus tribus guerreras el Colmillo recluta a los Lobos Espaciales, los ejecutores del Emperador.' },
    { name: 'Medusa', x: 296, y: 272, k: 'astartes', t: 1, type: 'Mundo Capitular', seg: 'Obscurus', fac: 'Manos de Hierro', blurb: 'Planeta volcánico y hostil recorrido por ciudades-oruga. Sus clanes forjan a las Manos de Hierro, que reemplazan la carne débil por bendito metal.' },
    { name: 'Valhalla', x: 476, y: 183, k: 'world', t: 1, type: 'Mundo de Hielo', seg: 'Obscurus', fac: 'Imperium', blurb: 'Mundo helado tras el impacto de un cometa. Sus regimientos de la Guardia Imperial son legendarios por resistir cualquier asedio sin ceder un palmo de hielo.' },
    { name: 'Deliverance', x: 640, y: 205, k: 'astartes', t: 1, type: 'Mundo Capitular', seg: 'Ultima', fac: 'Guardia del Cuervo', blurb: 'Luna penitenciaria de Kiavahr liberada por Corvus Corax. Hoy es la fortaleza de la Guardia del Cuervo, maestros de la sombra y la guerra encubierta.' },
    { name: 'Baal', x: 640, y: 239, k: 'astartes', t: 0, type: 'Mundo Capitular', seg: 'Ultima', fac: 'Ángeles Sangrientos', blurb: 'Mundo radiactivo orbitado por las lunas Baal Primus y Secundus. Hogar de los Ángeles Sangrientos, devastado por la Flota Enjambre Leviatán y salvado con la llegada de la Gran Grieta.' },
    { name: 'Chogoris', x: 940, y: 410, k: 'astartes', t: 1, type: 'Mundo Capitular', seg: 'Ultima', fac: 'Cicatrices Blancas', blurb: 'Mundo de estepas infinitas y tribus jinetes. De sus llanuras Jaghatai Khan forjó a las Cicatrices Blancas y su arte de la guerra relámpago.' },
    { name: 'Armageddon', x: 312, y: 331, k: 'world', t: 0, type: 'Mundo Colmena', seg: 'Solar', fac: 'Imperium', blurb: 'Colmena industrial escenario de tres guerras apocalípticas: la invasión demoníaca de Angron y dos Waaagh! del kaudillo orko Ghazghkull Thraka. Sigue en guerra.' },
    { name: 'La Roca', x: 383, y: 361, k: 'astartes', t: 1, type: 'Fortaleza errante', seg: 'Solar', fac: 'Ángeles Oscuros', blurb: 'Todo lo que queda de Caliban, el mundo natal de los Ángeles Oscuros destruido al final de la Herejía. Convertida en nave-monasterio errante, guarda en sus celdas los secretos de los Caídos.' },
    { name: 'Prospero', x: 386, y: 401, k: 'dead', t: 1, type: 'Mundo muerto', seg: 'Solar', fac: 'Abandonado', blurb: 'Ciudad de la sabiduría de los Mil Hijos, arrasada por los Lobos Espaciales en vísperas de la Herejía. Sobre sus ruinas de cristal flota ahora el Planeta de los Hechiceros.' },
    { name: 'El Maelstrom', x: 523, y: 468, k: 'warp', t: 0, type: 'Tormenta warp', seg: 'Ultima', fac: 'Caos', blurb: 'Vasta tormenta warp en el corazón galáctico, nido de piratas, renegados y señores de guerra. Desde la Guerra de Badab es el feudo de Huron Blackheart y sus Corsarios Rojos.' },
    { name: 'Cicatrix Maledictum', x: 610, y: 442, k: 'warp', t: 0, type: 'La Gran Grieta', seg: '—', fac: 'Caos', blurb: 'La cicatriz warp que partió la galaxia en dos tras la caída de Cadia (999.M41), separando el Imperium Sanctus del Imperium Nihilus, donde la luz del Astronomican apenas llega.' },
    { name: 'Catachan', x: 429, y: 475, k: 'world', t: 1, type: 'Mundo Letal', seg: 'Ultima', fac: 'Imperium', blurb: 'La jungla más letal del Imperio: aquí todo, flora y fauna, intenta matarte. Sus supervivientes forman los regimientos de combate selvático más duros de la Guardia.' },
    { name: 'Necromunda', x: 287, y: 520, k: 'world', t: 1, type: 'Mundo Colmena', seg: 'Solar', fac: 'Imperium', blurb: 'Colmena industrial de miles de millones de almas apiladas en ciudades verticales. Sus profundidades son territorio de bandas, y sus fundiciones alimentan los ejércitos del Imperio.' },
    { name: 'Krieg', x: 185, y: 564, k: 'world', t: 1, type: 'Mundo devastado', seg: 'Solar', fac: 'Imperium', blurb: 'Arrasado por guerra atómica civil durante quinientos años. Sus regimientos de asedio, los Korps de la Muerte, combaten con máscara antigás y absoluto desprecio por la propia vida.' },
    { name: 'Ophelia VII', x: 263, y: 592, k: 'world', t: 1, type: 'Mundo Cardenalicio', seg: 'Tempestus', fac: 'Eclesiarcado', blurb: 'Segundo corazón del Culto Imperial tras Terra: un mundo entero de catedrales, conventos y peregrinos. Sede de importantes órdenes del Adepta Sororitas.' },
    { name: 'Nocturne', x: 491, y: 598, k: 'astartes', t: 0, type: 'Mundo Capitular', seg: 'Ultima', fac: 'Salamandras', blurb: 'Mundo volcánico castigado por su luna Prometheus. Sus herreros-guerreros, las Salamandras, son los mejores forjadores del Adeptus Astartes y protectores de su pueblo.' },
    { name: 'Badab', x: 509, y: 533, k: 'dead', t: 1, type: 'Mundo capitular · perdido', seg: 'Ultima', fac: 'Renegados', blurb: 'Epicentro de la Guerra de Badab (901–912.M41), la rebelión del Tirano Lufgt Huron que enfrentó a capítulos Astartes entre sí. Huron cayó al Maelstrom y renació como Blackheart.' },
    { name: 'Rynn’s World', x: 516, y: 688, k: 'astartes', t: 1, type: 'Mundo Capitular', seg: 'Tempestus', fac: 'Puños Carmesíes', blurb: 'Mundo agrícola y fortaleza de los Puños Carmesíes, casi aniquilados cuando la Waaagh! de Snagrod destruyó su monasterio. Su reconstrucción es leyenda de tenacidad.' },
    { name: 'Macragge', x: 802, y: 684, k: 'astartes', t: 0, type: 'Mundo Capitular', seg: 'Ultima', fac: 'Ultramarines', blurb: 'Capital de los Quinientos Mundos de Ultramar y hogar de los Ultramarines. Aquí despertó Roboute Guilliman en 999.M41 para asumir el mando del Imperio como Lord Comandante.' },
    { name: 'Imperio T’au', x: 885, y: 598, k: 'xenos', t: 0, type: 'Dominio xenos', seg: 'Ultima', fac: 'T’au', blurb: 'Joven imperio alienígena en rápida expansión por el Fringe Oriental. Predica el Bien Supremo y absorbe mundos humanos fronterizos mediante diplomacia... o fuego de rieles.' },
    { name: 'Tormenta de la Ira', x: 516, y: 131, k: 'warp', t: 1, type: 'Tormenta warp', seg: 'Obscurus', fac: 'Caos', blurb: 'La Tormenta de la Ira del Emperador aísla del Astronomican a sistemas enteros del Segmentum Obscurus desde tiempos de la Herejía.' },
    { name: 'Tormenta de la Sirena', x: 428, y: 633, k: 'warp', t: 1, type: 'Tormenta warp', seg: 'Tempestus', fac: 'Caos', blurb: 'Tormenta warp cuyo canto atrae naves hacia su interior. Ninguna ha vuelto para explicar qué encontró.' },
    { name: 'Anomalía Hadex', x: 905, y: 630, k: 'warp', t: 1, type: 'Anomalía warp', seg: 'Ultima', fac: 'Caos', blurb: 'Anomalía warp que arde sobre el sector Charadon. Los astrópatas afirman que susurra, y que lo que susurra está vivo.' },
    { name: 'Dinastía Mephrit', x: 618, y: 290, k: 'necron', t: 1, type: 'Dinastía necrona', seg: 'Ultima', fac: 'Necrones', blurb: 'Dinastía necrona despertada en el norte del Ultima Segmentum. Sus mundos tumba despiertan uno a uno, y sus arcas solares apagan estrellas.' },
    { name: 'Dinastía Sautekh', x: 790, y: 617, k: 'necron', t: 1, type: 'Dinastía necrona', seg: 'Ultima', fac: 'Necrones', blurb: 'La más agresiva de las dinastías necronas, gobernada por Imotekh el Señor de la Tormenta, que expande su imperio mundo tumba a mundo tumba.' },
    { name: 'Dinastía Nihilakh', x: 712, y: 780, k: 'necron', t: 1, type: 'Dinastía necrona', seg: 'Tempestus', fac: 'Necrones', blurb: 'Dinastía necrona que atesora las reliquias de su antiguo imperio y no cede un solo mundo de los que reclama.' },
    { name: 'Imperio de Charadon', x: 722, y: 728, k: 'ork', t: 1, type: 'Imperio orko', seg: 'Ultima', fac: 'Orkos', blurb: 'El imperio orko más antiguo de la galaxia. Sus Waaagh! periódicas asolan los sectores vecinos desde hace milenios.' },
    { name: 'Golgotha', x: 487, y: 410, k: 'ork', t: 2, type: 'Mundo orko', seg: 'Ultima', fac: 'Orkos', blurb: 'Mundo desértico en poder de los orkos. Aquí la Waaagh! de Ghazghkull derrotó y capturó al Comisario Yarrick, que escapó jurando venganza.' },
    { name: 'Kar Duniash', x: 830, y: 381, k: 'world', t: 1, type: 'Base naval', seg: 'Ultima', fac: 'Imperium', blurb: 'Cuartel general de la Flota Imperial del Ultima Segmentum y uno de los grandes astilleros del este galáctico.' },
    { name: 'Hydraphur', x: 152, y: 330, k: 'world', t: 1, type: 'Base naval', seg: 'Pacificus', fac: 'Imperium', blurb: 'Gran fondeadero de la Flota Pacificus: un sistema entero de astilleros, arsenales y catedrales navales.' },
