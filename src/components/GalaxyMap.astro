    { name: 'False Hope', x: 764, y: 785, k: 'world', t: 2, type: 'Mundo Letal', seg: 'Ultima', fac: 'Imperium', blurb: 'Mundo letal cuyo nombre lo dice todo.' },
    { name: 'Salem', x: 805, y: 806, k: 'world', t: 2, type: 'Colonia', seg: 'Ultima', fac: 'Imperium', blurb: 'Colonia austral de la frontera sureste.' }
  ]

  const K = {
    capital: { mw: 14, br: '50%', bd: 'none', bg: 'radial-gradient(circle,#ffffff 30%,rgba(255,255,255,0) 72%)', sh: '0 0 18px 6px rgba(255,244,214,0.5)', iw: 0, mrot: 0, lc: '#ffffff', fs: 10.5, fw: 700, tc: '#e8d5b0' },
    astartes: { mw: 12, br: '50%', bd: '1px solid #dfe3e6', bg: 'transparent', sh: 'none', iw: 4, mrot: 0, lc: '#e8e6e0', fs: 9.5, fw: 600, tc: '#c8c6c0' },
    world: { mw: 5, br: '50%', bd: 'none', bg: '#cfd6da', sh: 'none', iw: 0, mrot: 0, lc: '#c8c6c0', fs: 9, fw: 400, tc: '#c8c6c0' },
    dead: { mw: 8, br: '50%', bd: '1px solid #8a8a92', bg: 'transparent', sh: 'none', iw: 0, mrot: 0, lc: '#9a9aa2', fs: 9, fw: 400, tc: '#9a9aa2' },
    warp: { mw: 13, br: '50%', bd: '1.5px dashed #c14a72', bg: 'rgba(193,58,107,0.15)', sh: '0 0 26px 10px rgba(193,58,107,0.2)', iw: 0, mrot: 0, lc: '#d97a9a', fs: 9.5, fw: 600, tc: '#d97a9a' },
    xenos: { mw: 8, br: '1px', bd: '1px solid #8fd0c8', bg: 'rgba(143,208,200,0.2)', sh: 'none', iw: 0, mrot: 45, lc: '#8fd0c8', fs: 9.5, fw: 600, tc: '#8fd0c8' },
    ork: { mw: 8, br: '2px', bd: '1px solid #8fbf5a', bg: 'rgba(143,191,90,0.2)', sh: 'none', iw: 0, mrot: 0, lc: '#a5c97a', fs: 9.5, fw: 600, tc: '#a5c97a' },
    necron: { mw: 8, br: '0', bd: '1px solid #9fb8a8', bg: 'rgba(159,184,168,0.15)', sh: 'none', iw: 0, mrot: 0, lc: '#b8ccbf', fs: 9.5, fw: 600, tc: '#b8ccbf' }
  }

  const REGIONS = [
    { t: 'SEGMENTUM OBSCURUS', x: 325, y: 85, s: 18, c: '#3c444c', rot: 0, tier: 0 },
    { t: 'SEGMENTUM SOLAR', x: 210, y: 380, s: 14, c: '#3c444c', rot: 0, tier: 0 },
    { t: 'SEGMENTUM TEMPESTUS', x: 300, y: 712, s: 18, c: '#3c444c', rot: 0, tier: 0 },
    { t: 'SEGMENTUM PACIFICUS', x: 70, y: 462, s: 13, c: '#3c444c', rot: 90, tier: 0 },
    { t: 'ULTIMA SEGMENTUM', x: 820, y: 300, s: 18, c: '#3c444c', rot: 0, tier: 0 },
    { t: 'IMPERIUM NIHILUS', x: 740, y: 152, s: 26, c: '#242b31', rot: 16, tier: 0 },
    { t: 'IMPERIUM SANCTUS', x: 400, y: 556, s: 26, c: '#242b31', rot: 16, tier: 0 },
    { t: 'CICATRIX MALEDICTUM', x: 452, y: 336, s: 12.5, c: '#d86a8a', rot: 24, tier: 0 },
    { t: 'ESTRELLAS HALO', x: 108, y: 98, s: 11, c: '#9a4a3a', rot: -28, tier: 1 },
    { t: 'ESTRELLAS GHOUL', x: 915, y: 105, s: 11, c: '#9a4a3a', rot: 22, tier: 1 },
    { t: 'FRANJA ORIENTAL', x: 1000, y: 480, s: 12, c: '#9a4a3a', rot: 73, tier: 1 },
    { t: 'LA REGIÓN VELADA', x: 352, y: 772, s: 11, c: '#9a4a3a', rot: -8, tier: 1 },
    { t: 'SECTOR GÓTICO', x: 458, y: 166, s: 9, c: '#8a4a44', rot: 0, tier: 1 },
    { t: 'SECTOR SCARUS', x: 198, y: 120, s: 9, c: '#8a4a44', rot: 0, tier: 1 },
    { t: 'SECTOR CALIXIS', x: 127, y: 148, s: 9, c: '#8a4a44', rot: 0, tier: 1 },
    { t: 'SECTOR FINIAL', x: 204, y: 157, s: 9, c: '#8a4a44', rot: 0, tier: 2 },
    { t: 'SECTOR UHULIS', x: 160, y: 592, s: 9, c: '#8a4a44', rot: 0, tier: 2 },
    { t: 'SECTOR CHARADON', x: 735, y: 652, s: 9, c: '#8a4a44', rot: 0, tier: 1 },
    { t: 'SECTOR NEPHILIM', x: 628, y: 700, s: 9, c: '#8a4a44', rot: 0, tier: 2 },
    { t: 'SECTOR REDUCTUS', x: 462, y: 708, s: 9, c: '#8a4a44', rot: 0, tier: 2 },
    { t: 'CONDUCTO ASTROTELEPÁTICO', x: 888, y: 222, s: 8.5, c: '#9a4a3a', rot: 14, tier: 2 }
  ]

  const state = { zoom: 1, panX: 0, panY: 40, sel: null, playing: true }
  let theta = 0            // ángulo actual de la órbita (rad)
  let dirty = true         // hay que reproyectar transform y overlay
  let needCollide = true   // hay que recalcular colisiones de labels
  let tween = null         // animación de zoom de los botones
  let modalTrigger = null  // nodo que abrió el modal, para devolverle el foco

  const vp = document.getElementById('gm-vp')
  const world = document.getElementById('gm-world')
  const disc = document.getElementById('gm-disc')
  const starsSvg = document.getElementById('gm-stars')
  const regionsEl = document.getElementById('gm-regions')
  const nodesEl = document.getElementById('gm-nodes')
  const modalEl = document.getElementById('gm-modal')
  const modalCard = document.getElementById('gm-modal-card')
  const lodEl = document.getElementById('gm-lod')
  const playBtn = document.getElementById('gm-play')
  const hintEl = document.getElementById('gm-hint')

  // En modo incrustado la rueda sola SIEMPRE desplaza la página (nunca se
  // secuestra el scroll); el zoom exige Ctrl/⌘ + rueda. El pinch de trackpad
  // llega como wheel con ctrlKey=true, así que funciona sin tecla.
  const wheelNeedsKey = vp.dataset.wheel === 'ctrl'
  let hintTimer = null
  function showHint () {
    if (!hintEl) return
    hintEl.style.opacity = '1'
    clearTimeout(hintTimer)
    hintTimer = setTimeout(() => { hintEl.style.opacity = '0' }, 1600)
  }

  // ---- estrellas (PRNG con semilla fija, como el original) ----
  function buildStars () {
    let s = 1337
    const rnd = () => { s = (s * 16807) % 2147483647; return s / 2147483647 }
    const pts = []
    for (let arm = 0; arm < 2; arm++) {
      for (let i = 0; i < 150; i++) {
        const t = i / 149, th = t * 7.5 + arm * Math.PI + (rnd() - 0.5) * 0.35
        const r = 42 * Math.exp(0.3 * t * 7.5) * (1 + (rnd() - 0.5) * 0.24)
        if (r > 390) continue
        const px = 560 + r * Math.cos(th), py = 435 + r * Math.sin(th) * 0.78
        if (px < 6 || px > 1074 || py < 6 || py > 842) continue
        pts.push({ x: px, y: py, sz: 0.4 + rnd() * 1.1, o: 0.25 + rnd() * 0.55 })
      }
    }
    for (let i = 0; i < 190; i++) pts.push({ x: 8 + rnd() * 1064, y: 8 + rnd() * 832, sz: 0.3 + rnd() * 1.2, o: 0.12 + rnd() * 0.45 })
    starsSvg.innerHTML = pts.map((p, i) =>
      `<circle cx="${p.x}" cy="${p.y}" r="${p.sz}" fill="${i % 17 === 0 ? '#e8d5b0' : i % 23 === 0 ? '#9fd8d4' : '#cfd6da'}" opacity="${p.o}"></circle>`
    ).join('')

    // Estrellas exteriores (misma densidad de fondo, fuera del rectángulo del disco).
    // El canvas exterior es 1460×1460 centrado en el núcleo; el disco ocupa
    // [170..1250]×[300..1148] en sus coordenadas.
    const outerSvg = document.getElementById('gm-stars-outer')
    const opts = []
    for (let i = 0; i < 440; i++) {
      const x = rnd() * 1460, y = rnd() * 1460
      if (x > 170 && x < 1250 && y > 300 && y < 1148) continue
      opts.push({ x, y, sz: 0.3 + rnd() * 1.1, o: 0.1 + rnd() * 0.38 })
    }
    outerSvg.innerHTML = opts.map((p, i) =>
      `<circle cx="${p.x}" cy="${p.y}" r="${p.sz}" fill="${i % 19 === 0 ? '#e8d5b0' : '#cfd6da'}" opacity="${p.o}"></circle>`
    ).join('')
  }

  // ---- construcción del overlay 2D (regiones y nodos) ----
  const regionRefs = [] // { el (wrap posicionado), inner (texto), tier, s, x, y }
  const nodeRefs = []   // { el (wrap), btn, labelEl, tier, x, y, sx, sy, lw, lh, on }

  function build () {
    REGIONS.forEach(r => {
      const wrap = document.createElement('div')
      wrap.style.cssText = 'position:absolute;left:0;top:0'
      wrap.innerHTML = `<div class="gm-region" style="position:absolute;transform:translate(-50%,-50%) rotate(${r.rot}deg);font-family:'Cinzel',serif;letter-spacing:0.32em;color:${r.c};white-space:nowrap">${r.t}</div>`
      regionsEl.appendChild(wrap)
      regionRefs.push({ el: wrap, inner: wrap.firstChild, tier: r.tier, s: r.s, x: r.x, y: r.y })
    })

    WORLDS.forEach(w => {
      const k = K[w.k]
      const name = w.name.replace(/"/g, '&quot;')
      const wrap = document.createElement('div')
      wrap.style.cssText = 'position:absolute;left:0;top:0'
      wrap.innerHTML = `<button type="button" class="gm-node" data-name="${name}" aria-label="${name}" aria-haspopup="dialog" style="position:absolute;transform:translate(-50%,-7.5px);display:flex;flex-direction:column;align-items:center;gap:3px;width:max-content;max-width:110px;padding:0;margin:0;background:none;border:none;font:inherit;cursor:pointer;pointer-events:auto">
        <span style="width:15px;height:15px;display:flex;align-items:center;justify-content:center">
          <span style="width:${k.mw}px;height:${k.mw}px;border-radius:${k.br};border:${k.bd};background:${k.bg};box-shadow:${k.sh};transform:rotate(${k.mrot}deg);display:flex;align-items:center;justify-content:center">
            <span style="width:${k.iw}px;height:${k.iw}px;border-radius:50%;background:#ffffff"></span>
          </span>
        </span>
        <span style="font-size:${k.fs}px;font-weight:${k.fw};letter-spacing:0.1em;color:${k.lc};text-align:center;line-height:1.2;text-shadow:0 1px 4px #000000">${w.name}</span>
      </button>`
      nodesEl.appendChild(wrap)
      const btn = wrap.querySelector('.gm-node')
      nodeRefs.push({ el: wrap, btn, labelEl: btn.lastElementChild, tier: w.t, x: w.x, y: w.y, sx: 0, sy: 0, lw: 60, lh: 12, on: true })
    })
    // medir los labels una vez para el pase de colisiones
    nodeRefs.forEach(n => { n.lw = n.labelEl.offsetWidth + 6; n.lh = n.labelEl.offsetHeight })
  }

  // ---- vista: proyección, límites y LOD ----
  // Mapa contenido: el zoom mínimo es el que hace que la galaxia cubra el viewport
  // (nunca se ve el vacío alrededor del disco)
  function minZoom () {
    return Math.max(vp.clientWidth / (EXT.left + EXT.right), vp.clientHeight / ((EXT.up + EXT.down) * K_TILT))
  }
  function maxZoom () { return minZoom() * 2.5 }

  // El viewport nunca sale de los límites del disco
  function clampPan () {
    const z = state.zoom
    const xMin = vp.clientWidth / 2 - EXT.right * z, xMax = EXT.left * z - vp.clientWidth / 2
    const yMin = vp.clientHeight / 2 - EXT.down * z * K_TILT, yMax = EXT.up * z * K_TILT - vp.clientHeight / 2
    state.panX = xMin > xMax ? (xMin + xMax) / 2 : Math.max(xMin, Math.min(xMax, state.panX))
    state.panY = yMin > yMax ? (yMin + yMax) / 2 : Math.max(yMin, Math.min(yMax, state.panY))
  }

  function setView (zoom, panX, panY) {
    const z = Math.max(minZoom(), Math.min(maxZoom(), zoom))
    const zoomChanged = z !== state.zoom
    state.zoom = z
    state.panX = panX
    state.panY = panY
    clampPan()
    if (zoomChanged) updateLod() // el LOD y el tamaño de las regiones solo dependen del zoom
    dirty = true
  }

  // Zoom multiplicativo anclado a un punto de pantalla (relativo al centro del vp)
  function zoomAt (factor, ax, ay) {
    const z = Math.max(minZoom(), Math.min(maxZoom(), state.zoom * factor))
    const f = z / state.zoom
    setView(z, ax - f * (ax - state.panX), ay - f * (ay - state.panY))
  }

  // Los umbrales de LOD son relativos al zoom de ajuste: misma densidad
  // inicial en cualquier tamaño de pantalla
  function updateLod () {
    const mz = minZoom()
    const t1 = state.zoom >= mz * 1.3, t2 = state.zoom >= mz * 1.9
    const showT = (t) => t === 0 || (t === 1 && t1) || (t === 2 && t2)
    lodEl.textContent = t2 ? 'detalle máximo' : t1 ? 'acerca más para ver todos los mundos' : 'acerca para ver más mundos y sectores'
    nodeRefs.forEach(n => {
      n.on = showT(n.tier)
      n.btn.style.opacity = n.on ? 0.92 : 0
      n.btn.style.pointerEvents = n.on ? 'auto' : 'none'
      n.btn.tabIndex = n.on ? 0 : -1
    })
    regionRefs.forEach(r => {
      r.inner.style.opacity = showT(r.tier) ? 1 : 0
      r.inner.style.fontSize = (r.s * state.zoom).toFixed(2) + 'px'
    })
    needCollide = true
  }

  function applyFrame () {
    const { zoom, panX, panY } = state
    const cw = vp.clientWidth / 2, ch = vp.clientHeight / 2
    const c = Math.cos(theta), s = Math.sin(theta)
    world.style.transform = `translate(${panX}px,${panY}px) scale(${zoom},${zoom * K_TILT})`
    disc.style.transform = `rotate(${theta}rad)`
    nodeRefs.forEach(n => {
      const dx = n.x - GC_X, dy = n.y - GC_Y
      n.sx = cw + panX + zoom * (dx * c - dy * s)
      n.sy = ch + panY + zoom * K_TILT * (dx * s + dy * c)
      n.el.style.transform = `translate3d(${n.sx.toFixed(1)}px,${n.sy.toFixed(1)}px,0)`
    })
    regionRefs.forEach(r => {
      const dx = r.x - GC_X, dy = r.y - GC_Y
      const sx = cw + panX + zoom * (dx * c - dy * s)
      const sy = ch + panY + zoom * K_TILT * (dx * s + dy * c)
      r.el.style.transform = `translate3d(${sx.toFixed(1)}px,${sy.toFixed(1)}px,0)`
    })
  }

  // Decluttering: oculta el label (no el marcador) de los mundos que chocan
  // con uno de mayor prioridad. Los marcadores siguen siendo clicables.
  let collideOrder = []
  let lastCollideTheta = 0
  function collide () {
    const placed = []
    collideOrder.forEach(n => {
      if (!n.on) return
      const r = { x: n.sx - n.lw / 2, y: n.sy + 10, w: n.lw, h: n.lh }
      const hit = placed.some(p => r.x < p.x + p.w && p.x < r.x + r.w && r.y < p.y + p.h && p.y < r.y + r.h)
      n.labelEl.style.visibility = hit ? 'hidden' : 'visible'
      if (!hit) placed.push(r)
    })
    lastCollideTheta = theta
    needCollide = false
  }

  // ---- bucle: órbita, tween de botones y repintado bajo demanda ----
  let last = performance.now()
  function loop (now) {
    if (tween) {
      const k = Math.min(1, (now - tween.t0) / tween.dur)
      const e = 1 - Math.pow(1 - k, 3)
      setView(tween.z0 + (tween.z1 - tween.z0) * e, tween.x0 + (tween.x1 - tween.x0) * e, tween.y0 + (tween.y1 - tween.y0) * e)
      if (k >= 1) tween = null
    }
    if (state.playing) { theta += (now - last) * SPIN; dirty = true }
    last = now
    if (dirty) {
      applyFrame()
      if (needCollide || Math.abs(theta - lastCollideTheta) > 0.02) collide()
      dirty = false
    }
    requestAnimationFrame(loop)
  }

  function tweenTo (z1, x1, y1, dur) {
    tween = { t0: performance.now(), dur: dur || 220, z0: state.zoom, z1, x0: state.panX, x1, y0: state.panY, y1 }
  }

  function setPlaying (on) {
    state.playing = on
    playBtn.textContent = on ? '❚❚ ÓRBITA' : '▶ ÓRBITA'
  }

  function fit () {
    setPlaying(true)
    tweenTo(minZoom(), 0, 0, 300)
  }

  // ---- vista de detalle: super-zoom al mundo + planeta + lore ----
  const planetEl = document.getElementById('gm-planet')
  let prevView = null // vista y estado de órbita antes de abrir, para volver al cerrar
  let modalTimer = null

  function openModal (name, trigger) {
    const w = WORLDS.find(x => x.name === name)
    if (!w) return
    if (!prevView) prevView = { zoom: state.zoom, panX: state.panX, panY: state.panY, playing: state.playing }
    state.sel = name
    modalTrigger = trigger || null
    setPlaying(false)

    // La cámara vuela al mundo: su punto del mapa queda bajo el planeta (ancla
    // a la izquierda en pantallas anchas, arriba en estrechas, con la card al lado)
    const wide = vp.clientWidth > 760
    const ax = vp.clientWidth * (wide ? 0.34 : 0.5)
    const ay = vp.clientHeight * (wide ? 0.52 : 0.30)
    const z = maxZoom()
    const c = Math.cos(theta), s = Math.sin(theta)
    const dx = w.x - GC_X, dy = w.y - GC_Y
    tweenTo(z, ax - vp.clientWidth / 2 - z * (dx * c - dy * s), ay - vp.clientHeight / 2 - z * K_TILT * (dx * s + dy * c), 700)

    const tc = K[w.k].tc
    modalEl.style.setProperty('--pc', tc)
    planetEl.style.left = ax + 'px'
    planetEl.style.top = ay + 'px'

    // Geometría del callout: P0 = borde del planeta, P1 = arranque de la línea
    // horizontal (y origen del contenedor); la diagonal une P1 con P0
    const R = Math.min(vp.clientHeight * (wide ? 0.46 : 0.30), wide ? 400 : 240) / 2
    let p0x, p0y, p1x, p1y, tw
    if (wide) {
      p0x = ax + R * 0.72
      p0y = ay - R * 0.72
      p1x = p0x + 96
      p1y = p0y - 72
      tw = Math.min(440, vp.clientWidth - p1x - 28)
    } else {
      p0x = ax
      p0y = ay + R - 4
      p1x = 20
      p1y = ay + R + 56
      tw = vp.clientWidth - 40
    }
    const vx = p0x - p1x, vy = p0y - p1y
    modalCard.style.left = p1x + 'px'
    modalCard.style.top = p1y + 'px'
    modalCard.style.width = tw + 'px'
    modalCard.innerHTML = `
      <span class="gm-l-diag" style="--ang:${(Math.atan2(vy, vx) * 180 / Math.PI).toFixed(2)}deg;width:${Math.hypot(vx, vy).toFixed(1)}px"><i class="gm-l-dot"></i></span>
      <span class="gm-l-horiz"></span>
      <button class="gm-x" data-close aria-label="Cerrar">✕</button>
      <div class="gm-l-body">
        <div style="font-size:10px;letter-spacing:0.3em;color:${tc};text-transform:uppercase">${w.type}</div>
        <h2 style="font-family:'Cinzel',serif;font-size:27px;font-weight:700;color:#ffffff;margin:6px 0 14px;letter-spacing:0.05em">${w.name}</h2>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:12.5px;color:#c8c6c0;margin-bottom:14px">
          <span style="color:#6a6a72;letter-spacing:0.14em;font-size:10.5px;text-transform:uppercase">Segmentum</span><span>${w.seg}</span>
          <span style="color:#6a6a72;letter-spacing:0.14em;font-size:10.5px;text-transform:uppercase">Control</span><span style="color:${tc}">${w.fac}</span>
        </div>
        <p style="font-size:13.5px;line-height:1.7;color:#b4b4bc;margin:0;text-wrap:pretty">${w.blurb}</p>
        <div style="margin-top:16px;font-family:monospace;font-size:9px;letter-spacing:0.22em;color:#6a6a72;text-transform:uppercase">Archivo Administratum · Ref ${w.seg} · M42</div>
      </div>`

    clearTimeout(modalTimer)
    modalEl.style.display = 'block'
    vp.classList.add('gm-detail')
    requestAnimationFrame(() => modalEl.classList.add('gm-open'))
    modalCard.querySelector('[data-close]').focus()
  }

  function closeModal () {
    if (state.sel === null) return
    state.sel = null
    modalEl.classList.remove('gm-open')
    vp.classList.remove('gm-detail')
    clearTimeout(modalTimer)
    modalTimer = setTimeout(() => { modalEl.style.display = 'none' }, 400)
    if (prevView) {
      tweenTo(prevView.zoom, prevView.panX, prevView.panY, 600)
      setPlaying(prevView.playing)
      prevView = null
    }
    if (modalTrigger) { modalTrigger.focus(); modalTrigger = null }
  }

  const modalOpen = () => state.sel !== null

  modalEl.addEventListener('click', (e) => {
    if (e.target === modalEl || e.target.closest('.gm-dim') || e.target.closest('[data-close]')) closeModal()
  })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal() })

  // ---- interacción ----
  let suppressClick = false // true tras un drag: el click de soltar no abre modal

  nodesEl.addEventListener('click', (e) => {
    if (suppressClick) return
    const node = e.target.closest('.gm-node')
    if (node) openModal(node.getAttribute('data-name'), node)
  })

  document.getElementById('gm-zin').addEventListener('click', () => {
    if (modalOpen()) return
    setPlaying(false)
    const z = Math.min(maxZoom(), state.zoom * 1.18), f = z / state.zoom
    tweenTo(z, f * state.panX, f * state.panY, 180)
  })
  document.getElementById('gm-zout').addEventListener('click', () => {
    if (modalOpen()) return
    setPlaying(false)
    const z = Math.max(minZoom(), state.zoom / 1.18), f = z / state.zoom
    tweenTo(z, f * state.panX, f * state.panY, 180)
  })
  document.getElementById('gm-zfit').addEventListener('click', () => { if (!modalOpen()) fit() })
  playBtn.addEventListener('click', () => { if (!modalOpen()) setPlaying(!state.playing) })

  vp.addEventListener('wheel', (e) => {
    if (modalOpen()) return
    if (wheelNeedsKey && !e.ctrlKey && !e.metaKey) { showHint(); return } // la página hace scroll
    e.preventDefault()
    tween = null
    if (state.playing) setPlaying(false)
    const dy = e.deltaY * (e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 120 : 1)
    // deltas pequeños = pinch/trackpad suave (coeficiente mayor); grandes = ticks de rueda
    const kf = Math.abs(dy) >= 40 ? 0.0022 : 0.008
    const f = Math.exp(-Math.max(-80, Math.min(80, dy)) * kf)
    const r = vp.getBoundingClientRect()
    zoomAt(f, e.clientX - r.left - r.width / 2, e.clientY - r.top - r.height / 2)
  }, { passive: false })

  // Pan con pointer events (ratón y táctil) + pinch con dos punteros.
  // En modo embed un dedo desplaza la página (touch-action:pan-y); el mapa
  // solo captura el gesto con dos dedos o con ratón.
  const ptrs = new Map()
  let panStart = null // { x, y, panX, panY }
  let pinch = null    // { d, mx, my } del frame anterior

  function startPan (x, y) { panStart = { x, y, panX: state.panX, panY: state.panY } }

  vp.addEventListener('pointerdown', (e) => {
    if (modalOpen() || e.target.closest('[data-hud], #gm-modal')) return
    if (e.pointerType === 'mouse' && e.button !== 0) return
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY })
    suppressClick = false
    pinch = null
    if (ptrs.size === 1) {
      const singleTouchScrollsPage = wheelNeedsKey && e.pointerType === 'touch'
      panStart = null
      if (!singleTouchScrollsPage) startPan(e.clientX, e.clientY)
    } else {
      panStart = null
    }
  })

  window.addEventListener('pointermove', (e) => {
    const p = ptrs.get(e.pointerId)
    if (!p) return
    p.x = e.clientX
    p.y = e.clientY
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()]
      const d = Math.hypot(a.x - b.x, a.y - b.y)
      const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2
      if (pinch) {
        suppressClick = true
        tween = null
        if (state.playing) setPlaying(false)
        const r = vp.getBoundingClientRect()
        zoomAt(d / pinch.d, pinch.mx - r.left - r.width / 2, pinch.my - r.top - r.height / 2)
        setView(state.zoom, state.panX + mx - pinch.mx, state.panY + my - pinch.my)
      }
      pinch = { d, mx, my }
    } else if (panStart) {
      const dx = e.clientX - panStart.x, dy = e.clientY - panStart.y
      if (!suppressClick && Math.hypot(dx, dy) > 5) {
        suppressClick = true
        vp.style.cursor = 'grabbing'
        tween = null
        if (state.playing) setPlaying(false)
      }
      if (suppressClick) setView(state.zoom, panStart.panX + dx, panStart.panY + dy)
    }
  })

  function endPointer (e) {
    if (!ptrs.delete(e.pointerId)) return
    pinch = null
    if (ptrs.size === 1) {
      const [a] = [...ptrs.values()]
      startPan(a.x, a.y)
    } else if (ptrs.size === 0) {
      panStart = null
      vp.style.cursor = 'grab'
      // el click derivado del pointerup se dispara después: liberar el flag un tick más tarde
      setTimeout(() => { suppressClick = false }, 0)
    }
  }
  window.addEventListener('pointerup', endPointer)
  window.addEventListener('pointercancel', endPointer)

  // Con touch-action:pan-y el navegador reclamaría también el gesto vertical
  // de dos dedos; se lo quitamos solo cuando hay más de un dedo sobre el mapa
  vp.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault() }, { passive: false })

  window.addEventListener('resize', () => { setView(state.zoom, state.panX, state.panY) })

  buildStars()
  build()
  collideOrder = [...nodeRefs].sort((a, b) => a.tier - b.tier)
  setView(minZoom(), 0, 0)
  updateLod()
  requestAnimationFrame(loop)
</script>
