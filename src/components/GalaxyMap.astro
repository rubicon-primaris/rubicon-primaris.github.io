  const lodEl = document.getElementById('gm-lod')
  const playBtn = document.getElementById('gm-play')

  // En modo incrustado la rueda solo hace zoom tras interactuar, para no
  // secuestrar el scroll de la página que lo contiene
  const wheelGated = vp.dataset.wheel === 'click'
  const hintEl = document.getElementById('gm-hint')
  let wheelActive = !wheelGated
  function setWheelActive (on) {
    wheelActive = !wheelGated || on
    if (hintEl) hintEl.style.opacity = wheelActive ? '0' : '1'
  }
  if (wheelGated) {
    vp.addEventListener('pointerdown', () => setWheelActive(true))
    vp.addEventListener('mouseleave', () => setWheelActive(false))
  }

  // ---- estrellas (PRNG con semilla fija, como el original) ----
  function buildStars () {
    let s = 1337
    const rnd = () => { s = (s * 16807) % 2147483647; return s / 2147483647 }
    const pts = []
    for (let arm = 0; arm < 2; arm++) {
      for (let i = 0; i < 150; i++) {
        const t = i / 149, th = t * 7.5 + arm * Math.PI + (rnd() - 0.5) * 0.35
        const r = 42 * Math.exp(0.3 * t * 7.5) * (1 + (rnd() - 0.5) * 0.24)
        if (r > 390) continue
        const px = 560 + r * Math.cos(th), py = 435 + r * Math.sin(th) * 0.78
        if (px < 6 || px > 1074 || py < 6 || py > 842) continue
        pts.push({ x: px, y: py, sz: 0.4 + rnd() * 1.1, o: 0.25 + rnd() * 0.55 })
      }
    }
    for (let i = 0; i < 190; i++) pts.push({ x: 8 + rnd() * 1064, y: 8 + rnd() * 832, sz: 0.3 + rnd() * 1.2, o: 0.12 + rnd() * 0.45 })
    starsSvg.innerHTML = pts.map((p, i) =>
      `<circle cx="${p.x}" cy="${p.y}" r="${p.sz}" fill="${i % 17 === 0 ? '#e8d5b0' : i % 23 === 0 ? '#9fd8d4' : '#cfd6da'}" opacity="${p.o}"></circle>`
    ).join('')
  }

  // ---- construcción de etiquetas de región y nodos ----
  const regionRefs = [] // { el, tier }
  const nodeRefs = []   // { el (clickable), tier }

  function build () {
    REGIONS.forEach(r => {
      const outer = document.createElement('div')
      outer.style.cssText = `position:absolute;left:${r.x}px;top:${r.y}px;width:0;height:0`
      outer.innerHTML = `<div class="gm-spinrev"><div class="gm-region" style="position:absolute;left:-180px;top:-10px;width:360px;text-align:center;font-family:'Cinzel',serif;font-size:${r.s}px;letter-spacing:0.32em;color:${r.c};white-space:nowrap;pointer-events:none;transform:rotate(${r.rot}deg)">${r.t}</div></div>`
      regionsEl.appendChild(outer)
      regionRefs.push({ el: outer.querySelector('.gm-region'), tier: r.tier })
    })

    WORLDS.forEach(w => {
      const k = K[w.k]
      const outer = document.createElement('div')
      outer.style.cssText = `position:absolute;left:${w.x}px;top:${w.y}px;width:0;height:0;transform-style:preserve-3d;z-index:3`
      outer.innerHTML = `<div class="gm-spinrev" style="transform-style:preserve-3d">
        <div class="gm-node" data-name="${w.name.replace(/"/g, '&quot;')}" style="position:absolute;left:-55px;top:-7px;width:110px;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;transform-origin:55px 7px">
          <div style="width:15px;height:15px;display:flex;align-items:center;justify-content:center">
            <div style="width:${k.mw}px;height:${k.mw}px;border-radius:${k.br};border:${k.bd};background:${k.bg};box-shadow:${k.sh};transform:rotate(${k.mrot}deg);display:flex;align-items:center;justify-content:center">
              <div style="width:${k.iw}px;height:${k.iw}px;border-radius:50%;background:#ffffff"></div>
            </div>
          </div>
          <div style="font-size:${k.fs}px;font-weight:${k.fw};letter-spacing:0.1em;color:${k.lc};text-align:center;line-height:1.2;text-shadow:0 1px 4px #000000">${w.name}</div>
        </div>
      </div>`
      nodesEl.appendChild(outer)
      nodeRefs.push({ el: outer.querySelector('.gm-node'), tier: w.t })
    })
  }

  // ---- estado → estilos ----
  function minZoom () {
    return Math.max(0.55, Math.min(1.3, Math.min(vp.clientWidth / 1150, vp.clientHeight / 950)))
  }

  function renderModal () {
    const w = WORLDS.find(x => x.name === state.sel)
    if (!w) { modalEl.style.display = 'none'; return }
    const tc = K[w.k].tc
    modalCard.innerHTML = `
      <button class="gm-x" data-close>✕</button>
      <div style="font-size:10px;letter-spacing:0.26em;color:${tc};text-transform:uppercase">${w.type}</div>
      <h2 style="font-family:'Cinzel',serif;font-size:24px;font-weight:700;color:#ffffff;margin:6px 0 14px">${w.name}</h2>
      <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:13px;color:#c8c6c0;margin-bottom:16px">
        <span style="color:#6a6a72">Segmentum</span><span>${w.seg}</span>
        <span style="color:#6a6a72">Control</span><span style="color:${tc}">${w.fac}</span>
      </div>
      <p style="font-size:13.5px;line-height:1.65;color:#a8a8b0;margin:0;text-wrap:pretty">${w.blurb}</p>`
    modalEl.style.display = 'flex'
  }

  function update () {
    const { zoom, panX, panY, playing, dragging } = state
    const t1 = zoom >= 0.95, t2 = zoom >= 1.5
    const showT = (t) => t === 0 || (t === 1 && t1) || (t === 2 && t2)
    const invZoom = Math.min(1.7, Math.max(0.5, 1 / zoom)).toFixed(3)

    world.style.transform = `translate(${panX}px,${panY}px) scale(${zoom}) rotateX(${TILT}deg)`
    world.style.transition = dragging ? 'none' : 'transform 0.18s ease-out'
    vp.classList.toggle('gm-paused', !playing)
    playBtn.textContent = playing ? '❚❚ ÓRBITA' : '▶ ÓRBITA'
    lodEl.textContent = t2 ? 'detalle máximo' : t1 ? 'acerca más para ver todos los mundos' : 'acerca para ver más mundos y sectores'

    nodeRefs.forEach(n => {
      const on = showT(n.tier)
      n.el.style.opacity = on ? 0.92 : 0
      n.el.style.pointerEvents = on ? 'auto' : 'none'
      n.el.style.transform = `rotateX(${-TILT}deg) translateZ(3px) scale(${invZoom})`
    })
    regionRefs.forEach(r => { r.el.style.opacity = showT(r.tier) ? 1 : 0 })

    renderModal()
  }

  function setState (patch) { Object.assign(state, patch); update() }
  function fit () { setState({ zoom: minZoom(), panX: 0, panY: 40 }) }

  // ---- interacción ----
  nodesEl.addEventListener('click', (e) => {
    const node = e.target.closest('.gm-node')
    if (node) { e.stopPropagation(); setState({ sel: node.getAttribute('data-name') }) }
  })

  modalEl.addEventListener('click', (e) => {
    if (e.target === modalEl || e.target.closest('[data-close]')) setState({ sel: null })
  })

  document.getElementById('gm-zin').addEventListener('click', () => {
    const z = Math.min(3.2, state.zoom * 1.18), f = z / state.zoom
    setState({ zoom: z, panX: f * state.panX, panY: f * state.panY })
  })
  document.getElementById('gm-zout').addEventListener('click', () => {
    const z = Math.max(minZoom(), state.zoom / 1.18), f = z / state.zoom
    setState({ zoom: z, panX: f * state.panX, panY: f * state.panY })
  })
  document.getElementById('gm-zfit').addEventListener('click', fit)
  playBtn.addEventListener('click', () => setState({ playing: !state.playing }))

  vp.addEventListener('wheel', (e) => {
    if (!wheelActive) return
    e.preventDefault()
    const z = Math.min(3.2, Math.max(minZoom(), state.zoom * (e.deltaY < 0 ? 1.07 : 1 / 1.07)))
    const f = z / state.zoom
    const r = vp.getBoundingClientRect()
    const cx = e.clientX - r.left - r.width / 2, cy = e.clientY - r.top - r.height / 2
    setState({ zoom: z, panX: state.panX + (1 - f) * (cx - state.panX), panY: state.panY + (1 - f) * (cy - state.panY) })
  }, { passive: false })

  vp.addEventListener('mousedown', (e) => {
    const sx = e.clientX, sy = e.clientY, px = state.panX, py = state.panY
    const mv = (ev) => setState({ panX: px + ev.clientX - sx, panY: py + ev.clientY - sy, dragging: true })
    const up = () => {
      window.removeEventListener('mousemove', mv)
      window.removeEventListener('mouseup', up)
      vp.style.cursor = 'grab'
      setState({ dragging: false })
    }
    vp.style.cursor = 'grabbing'
    window.addEventListener('mousemove', mv)
    window.addEventListener('mouseup', up)
  })

  buildStars()
  build()
  fit()
</script>
