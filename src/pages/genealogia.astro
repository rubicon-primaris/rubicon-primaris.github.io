  const pathMeta = [] // { el, kind: 'root'|'legion', id, dash, col, lostMult }

  function addPath (d, meta) {
    const p = document.createElementNS(SVGNS, 'path')
    p.setAttribute('d', d)
    p.setAttribute('fill', 'none')
    p.setAttribute('stroke', meta.col || '#ffffff')
    if (meta.dash) p.setAttribute('stroke-dasharray', meta.dash)
    edges.appendChild(p)
    pathMeta.push({ el: p, ...meta })
  }

