---
import Layout from '../layouts/Layout.astro'
---
<Layout>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

  <div id="gene-root" style="width:100vw;min-height:100vh;background:#080809;color:#e8e6e0;font-family:system-ui,'Segoe UI',sans-serif">
    <header style="text-align:center;padding:56px 24px 28px;display:flex;flex-direction:column;gap:14px;align-items:center">
      <div style="font-size:12px;letter-spacing:0.4em;color:#8a8a92;text-transform:uppercase">M30 — M41 · Adeptus Astartes</div>
      <h1 style="font-family:'Cinzel',serif;font-weight:700;font-size:clamp(32px,5vw,58px);margin:0;letter-spacing:0.06em;color:#ffffff">DE LEGIONES A CAPÍTULOS</h1>
      <p style="max-width:640px;margin:0;color:#a8a8b0;font-size:15px;line-height:1.6;text-wrap:pretty">Veinte legiones marcharon en la Gran Cruzada. Tras la Herejía de Horus, el Codex Astartes dividió a las leales en capítulos de mil guerreros. Pulsa una legión para seguir su linaje.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a href="/" class="gene-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">← LAS LEGIONES</a>
        <a href="/mapa" class="gene-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">MAPA DE LA GALAXIA →</a>
      </div>
      <div style="display:flex;gap:24px;align-items:center;font-size:12px;color:#8a8a92;flex-wrap:wrap;justify-content:center">
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:28px;height:0;border-top:2px solid #e8e6e0"></span>linaje leal</span>
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:28px;height:0;border-top:2px dashed #b3402f"></span><span style="color:#c96a5a">caos — legión traidora</span></span>
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:12px;height:12px;border:1px solid #6a6a72;position:relative"></span>registros eliminados</span>
      </div>
    </header>

    <div id="gene-controls" style="position:sticky;top:0;z-index:5;background:rgba(8,8,9,0.92);backdrop-filter:blur(4px);padding:10px 14px;display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
        <button data-filter="all" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Todas</button>
        <button data-filter="loyal" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Leales</button>
        <button data-filter="traitor" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Traidoras</button>
        <span style="width:1px;background:#2a2a30;margin:0 6px"></span>
        <button id="gene-zout" title="Alejar" class="gene-hb" style="cursor:pointer;font-size:14px;width:34px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">−</button>
        <button id="gene-zin" title="Acercar" class="gene-hb" style="cursor:pointer;font-size:14px;width:34px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">+</button>
        <button id="gene-zfit" class="gene-hb" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.1em;padding:8px 14px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">AJUSTAR</button>
    </div>

    <div id="gene-scroller" style="overflow-x:auto;padding:8px 0 40px;cursor:grab">
      <div id="gene-sizer" style="margin:0 auto;position:relative">
        <div id="gene-canvas" style="position:absolute;left:0;top:0;width:1320px;height:2650px;transform-origin:top left">
          <svg id="gene-edges" width="1320" height="2650" viewBox="0 0 1320 2650" style="position:absolute;left:0;top:0;pointer-events:none"></svg>
          <!-- banda superior (legiones I–X): las lineas de epoca se alejan del centro -->
          <div style="position:absolute;left:40px;top:805px;width:1240px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:48px;top:786px;font-size:11px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · 2ª FUNDACIÓN — CODEX ASTARTES</div>
          <div style="position:absolute;left:40px;top:950px;width:1240px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:48px;top:931px;font-size:11px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · HEREJÍA DE HORUS</div>
          <!-- banda inferior (legiones XI–XX) -->
          <div style="position:absolute;left:40px;top:1654px;width:1240px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:48px;top:1659px;font-size:11px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · HEREJÍA DE HORUS</div>
          <div style="position:absolute;left:40px;top:1799px;width:1240px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:48px;top:1804px;font-size:11px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · 2ª FUNDACIÓN — CODEX ASTARTES</div>
          <div style="position:absolute;left:40px;top:2604px;width:1240px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:48px;top:2609px;font-size:11px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M42 · FUNDACIÓN ULTIMA — CAPÍTULOS PRIMARIS EN TODOS LOS LINAJES LEALES</div>
          <!-- franja central: el Emperador y los capitulos sin linaje confirmado -->
          <div style="position:absolute;left:594px;top:1248px;width:132px;text-align:center;color:#ffffff;background:#080809;padding:6px 0;z-index:2">
            <div style="font-family:'Cinzel',serif;font-size:16px;letter-spacing:0.2em">TERRA</div>
            <div style="font-size:10px;letter-spacing:0.24em;color:#8a8a92;margin-top:2px">EL EMPERADOR</div>
          </div>
          <div style="position:absolute;left:880px;top:1366px;width:300px;text-align:left;font-size:9px;letter-spacing:0.16em;line-height:1.8;color:#6a6a72;z-index:2">CAPÍTULOS SIN LINAJE CONFIRMADO<br />REGISTROS PERDIDOS O CLASIFICADOS</div>
          <div id="gene-nodes"></div>
        </div>
      </div>
    </div>

    <aside id="gene-panel" style="display:none;position:fixed;right:20px;top:90px;width:300px;max-height:calc(100vh - 130px);overflow-y:auto;background:#0c0d10;border:1px solid #34343c;border-radius:3px;padding:22px;box-shadow:0 12px 40px rgba(0,0,0,0.6);z-index:10"></aside>

    <footer style="text-align:center;padding:12px 24px 48px;font-size:11px;color:#55555c;line-height:1.7">
      Diagrama no oficial creado por fans. Marcas geométricas originales; no reproduce la iconografía oficial.<br />Warhammer 40,000 es propiedad de Games Workshop.
    </footer>
  </div>
</Layout>

<style is:global>
  /* El Layout centra el body con flex y fija height:100%; esta página es más alta que la ventana */
  body:has(#gene-root) { display: block; height: auto }
  #gene-root { user-select: none; -webkit-user-select: none }
  #gene-root a { color: #e8e6e0 }
  #gene-root a:hover { color: #ffffff }
  #gene-root ::-webkit-scrollbar { height: 10px; width: 10px }
  #gene-root ::-webkit-scrollbar-track { background: #0a0a0c }
  #gene-root ::-webkit-scrollbar-thumb { background: #2a2a30; border-radius: 5px }
  #gene-root .gene-hb:hover { border-color: #ffffff !important }
  #gene-root .gene-lg { transition: opacity .25s, transform .18s ease }
  #gene-root .gene-lg:hover { opacity: 1 !important; transform: scale(1.06); z-index: 5 }
  #gene-root .gene-lg:hover [data-mark] { filter: drop-shadow(0 0 9px rgba(255, 255, 255, 0.55)) }
  #gene-root .gene-chap { transition: opacity .25s, transform .18s ease, box-shadow .18s ease, background .18s ease }
  #gene-root .gene-chap:hover {
    border-color: #ffffff !important; transform: scale(1.08); z-index: 5;
    background: #15171d !important;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.75), 0 0 14px rgba(255, 255, 255, 0.09);
  }
  #gene-root .gene-wb { transition: opacity .25s, transform .18s ease, box-shadow .18s ease, background .18s ease }
  #gene-root .gene-wb:hover {
    border-color: #c96a5a !important; transform: scale(1.08); z-index: 5;
    background: #1c0f0e !important;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.75), 0 0 16px rgba(193, 58, 107, 0.28);
  }
  #gene-root .gene-term { transition: opacity .25s }
  #gene-root #gene-edges path { transition: opacity .25s }
  #gene-root .gene-cust { transition: opacity .25s, transform .18s ease, box-shadow .18s ease }
  #gene-root .gene-cust:hover {
    border-color: #e0b31f !important; transform: scale(1.08); z-index: 5;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.75), 0 0 16px rgba(201, 162, 39, 0.3);
  }
  #gene-root .gene-x { position: absolute; right: 10px; top: 10px; cursor: pointer; background: transparent; border: none; color: #8a8a92; font-size: 16px }
  #gene-root .gene-x:hover { color: #ffffff }
  /* animacion de apertura del panel al pulsar una tarjeta */
  #gene-panel.gene-panel-in { animation: genePanelIn .3s cubic-bezier(0.2, 0.75, 0.25, 1) }
  @keyframes genePanelIn {
    from { opacity: 0; transform: translateX(28px) scale(0.97) }
    to { opacity: 1; transform: none }
  }
  @media (max-width: 640px) {
    @keyframes genePanelIn {
      from { opacity: 0; transform: translateY(32px) }
      to { opacity: 1; transform: none }
    }
  }
  #gene-scroller { -webkit-overflow-scrolling: touch }
  /* Movil: cabecera compacta y el panel pasa a ser una hoja inferior */
  @media (max-width: 640px) {
    #gene-root header { padding: 30px 14px 16px !important; gap: 10px !important }
    #gene-panel {
      left: 10px !important; right: 10px !important; top: auto !important; bottom: 10px !important;
      width: auto !important; max-height: 56vh !important;
    }
  }
</style>

<script>
  // Port a JS vanilla del diseño "Genealogia Astartes.dc.html" (Claude Design)
  const SHOW_LOST = true
  const LINE_BASE = 0.4
  // Reloj de arena: el Emperador en el centro, legiones I–X hacia arriba y XI–XX hacia abajo.
  // Cada banda tiene su propio bus; los capitulos sin linaje flotan en la franja central.
  const W = 1320, H = 2650
  const colW = 124, mL = 40
  const CY1 = 1160, CY2 = 1444   // bus superior (banda I–X) y bus inferior (banda XI–XX)
  const rowH = 84, cardH = 72    // paso y altura FIJA de tarjeta: separacion uniforme
  const CH = '#b3402f', CHT = '#c96a5a'
  const x = (i) => mL + i * colW + colW / 2

  const M = {
    sword:  { p1: '24,5 27,11 27,33 24,42 21,33 21,11', p2: '14,14 34,14 34,18 14,18' },
    censor: { ringR: 16, p1: '11,34 34,11 37,14 14,37' },
    gem:    { ringR: 17, p1: '24,10 31,24 24,38 17,24' },
    hazard: { p1: '9,27 24,12 39,27 33,27 24,18 15,27', p2: '14,32 34,32 34,36 14,36' },
    bolt:   { p1: '29,4 15,26 22,26 19,44 34,20 26,20' },
    fangs:  { p1: '20,6 30,6 25,42', p2: '11,13 18,13 15,35' },
    fist:   { p1: '24,7 41,24 24,41 7,24', p2: '24,16 32,24 24,32 16,24', p2f: '#0c0d10' },
    terror: { ringR: 16, p1: '16,29 24,13 32,29' },
    drop:   { p1: '24,6 31,26 17,26', dotR: 9, dotY: 30 },
    hand:   { ringR: 16, p1: '18,18 30,18 30,30 18,30' },
    omega:  { ringR: 13, p1: '9,36 18,36 18,40 9,40', p2: '30,36 39,36 39,40 30,40' },
    plague: { ringR: 16, p1: '17,18 31,18 24,31' },
    column: { p1: '22,10 26,10 26,40 22,40', dotR: 5, dotY: 14 },
    eye:    { ringR: 16, dotR: 6, dotY: 24 },
    book:   { p1: '9,17 22,13 22,35 9,39', p2: '39,17 26,13 26,35 39,39' },
    flame:  { p1: '12,40 12,22 18,28 24,9 30,28 36,19 36,40' },
    wings:  { p1: '24,15 6,27 10,31 24,21', p2: '24,15 42,27 38,31 24,21', dotR: 3, dotY: 12 },
    alpha:  { p1: '24,7 35,41 30,41 24,19 18,41 13,41', p2: '19,29 29,29 29,33 19,33' }
  }

  const S = (n, tag) => ({ n, tag: tag || '2ª Fundación' })
  const D = [
    { id: 'I', name: 'Ángeles Oscuros', en: 'Dark Angels', st: 'loyal', mark: M.sword, primarch: 'Lion El’Jonson', world: 'Caliban', blurb: 'La Primera Legión. Guardan el secreto de los Caídos y persiguen su redención a través de los siglos. Sus sucesores comparten esa caza silenciosa.', succ: [S('Ángeles Oscuros', 'Capítulo'), S('Á. de la Absolución'), S('Á. de la Redención'), S('Á. de la Venganza'), S('Consagradores'), S('Discípulos de Caliban', 'Posterior'), S('Guardianes del Pacto'), S('Ángeles del Desafío')] },
    { id: 'II', name: '██████', en: 'Registros eliminados', st: 'lost', mark: M.censor, primarch: 'Desconocido', world: 'Desconocido', blurb: 'Toda mención de la Segunda Legión fue borrada de los archivos imperiales. Nada se sabe, y preguntar es peligroso.', succ: [] },
    { id: 'III', name: 'Hijos del Emperador', en: 'Emperor’s Children', st: 'traitor', mark: M.gem, primarch: 'Fulgrim', world: 'Chemos', blurb: 'Buscaron la perfección hasta corromperse. Cayeron ante Slaanesh y hoy son bandas de guerra hedonistas en el Ojo del Terror.', succ: [] },
    { id: 'IV', name: 'Guerreros de Hierro', en: 'Iron Warriors', st: 'traitor', mark: M.hazard, primarch: 'Perturabo', world: 'Olympia', blurb: 'Maestros del asedio, amargados por la falta de gloria. Traicionaron al Imperio y perfeccionan la guerra de trincheras al servicio del Caos.', succ: [] },
    { id: 'V', name: 'Cicatrices Blancas', en: 'White Scars', st: 'loyal', mark: M.bolt, primarch: 'Jaghatai Khan', world: 'Chogoris', blurb: 'Jinetes veloces de las estepas de Chogoris. La guerra relámpago es su arte; ningún enemigo escapa a su caza.', succ: [S('Cicatrices Blancas', 'Capítulo'), S('Señores de la Tormenta'), S('Saqueadores'), S('Destructores', '2ª F · destruido'), S('Merodeadores'), S('Halcones Solares')] },
    { id: 'VI', name: 'Lobos Espaciales', en: 'Space Wolves', st: 'loyal', mark: M.fangs, primarch: 'Leman Russ', world: 'Fenris', blurb: 'Los ejecutores del Emperador, salvajes e indomables. Rechazaron dividirse; solo un capítulo sucesor fue creado, y acabó en tragedia.', succ: [S('Lobos Espaciales', 'Capítulo'), S('Hermanos del Lobo', '2ª F · disuelto')] },
    { id: 'VII', name: 'Puños Imperiales', en: 'Imperial Fists', st: 'loyal', mark: M.fist, primarch: 'Rogal Dorn', world: 'Terra', blurb: 'Defensores de Terra durante el Asedio. Maestros de la fortificación y padres de algunos de los capítulos más célebres del Imperio.', succ: [S('Puños Imperiales', 'Capítulo'), S('Puños Carmesíes'), S('Templarios Negros'), S('Excoriadores'), S('Puños Ejemplares'), S('Bebedores de Almas'), S('Verdugos'), S('Martillos de Dorn', 'Posterior'), S('Caballeros de Hierro'), S('Retribuidores', 'Posterior')] },
    { id: 'VIII', name: 'Señores de la Noche', en: 'Night Lords', st: 'traitor', mark: M.terror, primarch: 'Konrad Curze', world: 'Nostramo', blurb: 'Impusieron el orden mediante el terror hasta que el terror fue su único credo. Hoy aterrorizan la galaxia como saqueadores sin dios.', succ: [] },
    { id: 'IX', name: 'Ángeles Sangrientos', en: 'Blood Angels', st: 'loyal', mark: M.drop, primarch: 'Sanguinius', world: 'Baal', blurb: 'Nobles y trágicos, marcados por la muerte de Sanguinius. Su linaje hereda la Sed Roja y la Furia Negra.', succ: [S('Ángeles Sangrientos', 'Capítulo'), S('Desgarradores de Carne'), S('Á. Encarnadinos'), S('Á. Sanguinos'), S('Á. Bermellón'), S('Bebedores de Sangre'), S('Devoradores de Carne'), S('Lamentadores', '21ª Fundación')] },
    { id: 'X', name: 'Manos de Hierro', en: 'Iron Hands', st: 'loyal', mark: M.hand, primarch: 'Ferrus Manus', world: 'Medusa', blurb: 'La carne es débil. Tras perder a su primarca en Istvaan V, reemplazan cuerpo y compasión por hierro frío.', succ: [S('Manos de Hierro', 'Capítulo'), S('Garras Rojas'), S('Zarpas de Bronce'), S('Hijos de Medusa', 'M36 · cisma'), S('Señores de Hierro')] },
    { id: 'XI', name: '██████', en: 'Registros eliminados', st: 'lost', mark: M.censor, primarch: 'Desconocido', world: 'Desconocido', blurb: 'La Undécima Legión no existe. Nunca existió. Los archivos así lo confirman.', succ: [] },
    { id: 'XII', name: 'Devoradores de Mundos', en: 'World Eaters', prev: 'Sabuesos de Guerra', st: 'traitor', mark: M.hazard, primarch: 'Angron', world: 'Nuceria', blurb: 'Berserkers esclavos de los Clavos Carniceros. Entregados a Khorne, solo conocen la sangre y los cráneos.', succ: [] },
    { id: 'XIII', name: 'Ultramarines', en: 'Ultramarines', st: 'loyal', mark: M.omega, primarch: 'Roboute Guilliman', world: 'Macragge', blurb: 'La legión más numerosa. Guilliman escribió el Codex Astartes y dio ejemplo dividiéndola: la mayoría de capítulos descienden de su semilla genética.', succ: [S('Ultramarines', 'Capítulo'), S('Novamarines'), S('Capítulo Génesis'), S('Águilas de la Perdición'), S('Mortifactores'), S('Cónsules Negros'), S('Cónsules Blancos'), S('Pretores de Orfeo'), S('Grifos Aulladores', 'Probable'), S('Capítulo Aurora'), S('Hijos de Orar'), S('Guadañas del Emperador'), S('Águilas Plateadas'), S('Libadores'), S('Marines Errantes', 'Probable')] },
    { id: 'XIV', name: 'Guardia de la Muerte', en: 'Death Guard', prev: 'Incursores del Crepúsculo', st: 'traitor', mark: M.plague, primarch: 'Mortarion', world: 'Barbarus', blurb: 'Infantería imparable corrompida por la Plaga del Destructor. Sirven a Nurgle como heraldos de la enfermedad.', succ: [] },
    { id: 'XV', name: 'Mil Hijos', en: 'Thousand Sons', st: 'traitor', mark: M.column, primarch: 'Magnus el Rojo', world: 'Prospero', blurb: 'Hechiceros condenados por su búsqueda del conocimiento. La Rubrica de Ahriman redujo a la mayoría a polvo dentro de sus armaduras.', succ: [] },
    { id: 'XVI', name: 'Hijos de Horus', en: 'Sons of Horus', prev: 'Lobos Lunares', st: 'traitor', mark: M.eye, primarch: 'Horus', world: 'Cthonia', blurb: 'La legión del Señor de la Guerra, origen de la Herejía. Tras su derrota renacieron como la Legión Negra de Abaddon.', succ: [] },
    { id: 'XVII', name: 'Portadores de la Palabra', en: 'Word Bearers', prev: 'Heraldos Imperiales', st: 'traitor', mark: M.book, primarch: 'Lorgar', world: 'Colchis', blurb: 'Los primeros en caer. Su fe desmedida encontró en el Caos los dioses que el Emperador les negó, y sembraron la Herejía.', succ: [] },
    { id: 'XVIII', name: 'Salamandras', en: 'Salamanders', st: 'loyal', mark: M.flame, primarch: 'Vulkan', world: 'Nocturne', blurb: 'Forjadores y protectores de la humanidad. Diezmados en Istvaan V; su semilla genética apenas produjo sucesores.', succ: [S('Salamandras', 'Capítulo'), S('Dragones Negros', '21ª F · disputado')] },
    { id: 'XIX', name: 'Guardia del Cuervo', en: 'Raven Guard', st: 'loyal', mark: M.wings, primarch: 'Corvus Corax', world: 'Deliverance', blurb: 'Señores de la sombra y la guerra encubierta. Casi aniquilados en Istvaan V, reconstruyeron su linaje desde las cenizas.', succ: [S('Guardia del Cuervo', 'Capítulo'), S('Guardia Negra'), S('Injuriadores'), S('Raptores')] },
    { id: 'XX', name: 'Legión Alfa', en: 'Alpha Legion', st: 'traitor', mark: M.alpha, primarch: 'Alpharius Omegon', world: 'Desconocido', blurb: 'Maestros del engaño y la infiltración. Nadie sabe con certeza por qué se volvieron traidores, ni si de verdad lo son.', succ: [] }
  ]

  const ORPHANS = [
    { n: 'Caballeros Grises', tag: 'M31 · clasificado' }, { n: 'Cuervos Sangrientos', tag: 'Rumor: XV' },
    { n: 'Legión de los Condenados', tag: 'M36 · espectral' }, { n: 'Minotauros', tag: 'Alto Senado' },
    { n: 'Escorpiones Rojos', tag: 'Desconocido' }, { n: 'Exorcistas', tag: 'Ordo Malleus' },
    { n: 'Leones Celestiales', tag: 'Disputado' }, { n: 'Carcharodons', tag: 'Rumor: XIX' },
    { n: 'Marines Malevolentes', tag: 'Desconocido' }, { n: 'Fantasmas Estelares', tag: 'Desconocido' },
    { n: 'Cráneos Plateados', tag: 'Desconocido' },
    // sin linaje confirmado... y caidos al Caos
    { n: 'Garras Astrales', tag: 'Renegados · Badab', fallen: true },
    { n: 'Sables Carmesíes', tag: 'Caos · M41', fallen: true },
    { n: 'Hijos de la Malicia', tag: 'Excomulgados', fallen: true },
    { n: 'Hijos de la Venganza', tag: 'Renegados', fallen: true }
  ]

