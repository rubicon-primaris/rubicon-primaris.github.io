      <polygon points="${m.p1 || '0,0'}" fill="${m.p1f || '#ffffff'}"></polygon>
      <polygon points="${m.p2 || '0,0'}" fill="${m.p2f || '#ffffff'}"></polygon>
    </svg>`
  }

  function build () {
