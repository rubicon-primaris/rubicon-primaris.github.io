---
import Layout from '../layouts/Layout.astro'
---
<Layout>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

  <div id="gene-root" style="width:100vw;min-height:100vh;background:#080809;color:#e8e6e0;font-family:system-ui,'Segoe UI',sans-serif">
    <header style="text-align:center;padding:56px 24px 28px;display:flex;flex-direction:column;gap:14px;align-items:center">
      <div style="font-size:12px;letter-spacing:0.4em;color:#8a8a92;text-transform:uppercase">M30 — M41 · Adeptus Astartes</div>
      <h1 style="font-family:'Cinzel',serif;font-weight:700;font-size:clamp(32px,5vw,58px);margin:0;letter-spacing:0.06em;color:#ffffff">DE LEGIONES A CAPÍTULOS</h1>
      <p style="max-width:640px;margin:0;color:#a8a8b0;font-size:15px;line-height:1.6;text-wrap:pretty">Veinte legiones marcharon en la Gran Cruzada. Tras la Herejía de Horus, el Codex Astartes dividió a las leales en capítulos de mil guerreros. Pulsa una legión para seguir su linaje.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a href="/" class="gene-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">← LAS LEGIONES</a>
        <a href="/mapa" class="gene-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">MAPA DE LA GALAXIA →</a>
      </div>
      <div style="display:flex;gap:24px;align-items:center;font-size:12px;color:#8a8a92;flex-wrap:wrap;justify-content:center">
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:28px;height:0;border-top:2px solid #e8e6e0"></span>linaje leal</span>
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:28px;height:0;border-top:2px dashed #b3402f"></span><span style="color:#c96a5a">caos — legión traidora</span></span>
        <span style="display:flex;align-items:center;gap:8px"><span style="display:inline-block;width:12px;height:12px;border:1px solid #6a6a72;position:relative"></span>registros eliminados</span>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:6px">
        <button data-filter="all" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Todas</button>
        <button data-filter="loyal" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Leales</button>
        <button data-filter="traitor" class="gene-hb gene-fbtn" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;padding:8px 18px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">Traidoras</button>
        <span style="width:1px;background:#2a2a30;margin:0 6px"></span>
        <button id="gene-zout" title="Alejar" class="gene-hb" style="cursor:pointer;font-size:14px;width:34px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">−</button>
        <button id="gene-zin" title="Acercar" class="gene-hb" style="cursor:pointer;font-size:14px;width:34px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">+</button>
        <button id="gene-zfit" class="gene-hb" style="cursor:pointer;font-family:inherit;font-size:12px;letter-spacing:0.1em;padding:8px 14px;border:1px solid #34343c;background:transparent;color:#e8e6e0;border-radius:2px">AJUSTAR</button>
      </div>
    </header>

    <div id="gene-scroller" style="overflow-x:auto;padding:8px 0 40px;cursor:grab">
      <div id="gene-sizer" style="margin:0 auto;position:relative">
        <div id="gene-canvas" style="position:absolute;left:0;top:0;width:1912px;height:1330px;transform-origin:top left">
          <svg id="gene-edges" width="1912" height="1330" viewBox="0 0 1912 1330" style="position:absolute;left:0;top:0;pointer-events:none"></svg>
          <div style="position:absolute;left:912px;top:8px;width:88px;text-align:center;color:#ffffff">
            <div style="font-family:'Cinzel',serif;font-size:13px;letter-spacing:0.2em">TERRA</div>
            <div style="font-size:9px;letter-spacing:0.24em;color:#8a8a92;margin-top:2px">EL EMPERADOR</div>
          </div>
          <div style="position:absolute;left:36px;top:288px;width:1840px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:44px;top:293px;font-size:10px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · HEREJÍA DE HORUS</div>
          <div style="position:absolute;left:36px;top:410px;width:1840px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:44px;top:415px;font-size:10px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M31 · 2ª FUNDACIÓN — CODEX ASTARTES</div>
          <div style="position:absolute;left:36px;top:1048px;width:1840px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:44px;top:1053px;font-size:10px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">CAPÍTULOS SIN LINAJE CONFIRMADO — REGISTROS PERDIDOS O CLASIFICADOS</div>
          <div style="position:absolute;left:36px;top:1250px;width:1840px;border-top:1px solid #26262c"></div>
          <div style="position:absolute;left:44px;top:1255px;font-size:10px;letter-spacing:0.3em;color:#6a6a72;background:#080809;padding:0 8px">M42 · FUNDACIÓN ULTIMA — CAPÍTULOS PRIMARIS EN TODOS LOS LINAJES LEALES</div>
          <div id="gene-nodes"></div>
        </div>
      </div>
    </div>

    <aside id="gene-panel" style="display:none;position:fixed;right:20px;top:90px;width:300px;max-height:calc(100vh - 130px);overflow-y:auto;background:#0c0d10;border:1px solid #34343c;border-radius:3px;padding:22px;box-shadow:0 12px 40px rgba(0,0,0,0.6);z-index:10"></aside>

    <footer style="text-align:center;padding:12px 24px 48px;font-size:11px;color:#55555c;line-height:1.7">
      Diagrama no oficial creado por fans. Marcas geométricas originales; no reproduce la iconografía oficial.<br />Warhammer 40,000 es propiedad de Games Workshop.
    </footer>
  </div>
</Layout>

<style is:global>
  /* El Layout centra el body con flex y fija height:100%; esta página es más alta que la ventana */
  body:has(#gene-root) { display: block; height: auto }
  #gene-root a { color: #e8e6e0 }
  #gene-root a:hover { color: #ffffff }
  #gene-root ::-webkit-scrollbar { height: 10px; width: 10px }
  #gene-root ::-webkit-scrollbar-track { background: #0a0a0c }
  #gene-root ::-webkit-scrollbar-thumb { background: #2a2a30; border-radius: 5px }
  #gene-root .gene-hb:hover { border-color: #ffffff !important }
  #gene-root .gene-lg { transition: opacity .25s }
  #gene-root .gene-lg:hover { opacity: 1 !important }
  #gene-root .gene-chap { transition: opacity .25s }
  #gene-root .gene-chap:hover { border-color: #ffffff !important }
  #gene-root .gene-wb { transition: opacity .25s }
  #gene-root .gene-wb:hover { border-color: #c96a5a !important }
  #gene-root .gene-term { transition: opacity .25s }
  #gene-root #gene-edges path { transition: opacity .25s }
  #gene-root .gene-x { position: absolute; right: 10px; top: 10px; cursor: pointer; background: transparent; border: none; color: #8a8a92; font-size: 16px }
  #gene-root .gene-x:hover { color: #ffffff }
</style>

<script>
  // Port a JS vanilla del diseño "Genealogia Astartes.dc.html" (Claude Design)
  const SHOW_LOST = true
  const LINE_BASE = 0.4
  const W = 1912, H = 1330
  const colW = 92, mL = 36
  const busY = 100, legTop = 124, legBot = 248, rowY0 = 450, rowH = 62, wbY = 336
  const CH = '#b3402f', CHT = '#c96a5a'
  const x = (i) => mL + i * colW + 46

  const M = {
    sword:  { p1: '24,5 27,11 27,33 24,42 21,33 21,11', p2: '14,14 34,14 34,18 14,18' },
    censor: { ringR: 16, p1: '11,34 34,11 37,14 14,37' },
    gem:    { ringR: 17, p1: '24,10 31,24 24,38 17,24' },
    hazard: { p1: '9,27 24,12 39,27 33,27 24,18 15,27', p2: '14,32 34,32 34,36 14,36' },
    bolt:   { p1: '29,4 15,26 22,26 19,44 34,20 26,20' },
    fangs:  { p1: '20,6 30,6 25,42', p2: '11,13 18,13 15,35' },
    fist:   { p1: '24,7 41,24 24,41 7,24', p2: '24,16 32,24 24,32 16,24', p2f: '#0c0d10' },
    terror: { ringR: 16, p1: '16,29 24,13 32,29' },
    drop:   { p1: '24,6 31,26 17,26', dotR: 9, dotY: 30 },
    hand:   { ringR: 16, p1: '18,18 30,18 30,30 18,30' },
    omega:  { ringR: 13, p1: '9,36 18,36 18,40 9,40', p2: '30,36 39,36 39,40 30,40' },
    plague: { ringR: 16, p1: '17,18 31,18 24,31' },
    column: { p1: '22,10 26,10 26,40 22,40', dotR: 5, dotY: 14 },
    eye:    { ringR: 16, dotR: 6, dotY: 24 },
    book:   { p1: '9,17 22,13 22,35 9,39', p2: '39,17 26,13 26,35 39,39' },
    flame:  { p1: '12,40 12,22 18,28 24,9 30,28 36,19 36,40' },
    wings:  { p1: '24,15 6,27 10,31 24,21', p2: '24,15 42,27 38,31 24,21', dotR: 3, dotY: 12 },
    alpha:  { p1: '24,7 35,41 30,41 24,19 18,41 13,41', p2: '19,29 29,29 29,33 19,33' }
  }

  const S = (n, tag) => ({ n, tag: tag || '2ª Fundación' })
  const D = [
    { id: 'I', name: 'Ángeles Oscuros', en: 'Dark Angels', st: 'loyal', mark: M.sword, primarch: 'Lion El’Jonson', world: 'Caliban', blurb: 'La Primera Legión. Guardan el secreto de los Caídos y persiguen su redención a través de los siglos. Sus sucesores comparten esa caza silenciosa.', succ: [S('Ángeles Oscuros', 'Capítulo'), S('Á. de la Absolución'), S('Á. de la Redención'), S('Á. de la Venganza'), S('Consagradores'), S('Discípulos de Caliban', 'Posterior'), S('Guardianes del Pacto'), S('Ángeles del Desafío')] },
    { id: 'II', name: '██████', en: 'Registros eliminados', st: 'lost', mark: M.censor, primarch: 'Desconocido', world: 'Desconocido', blurb: 'Toda mención de la Segunda Legión fue borrada de los archivos imperiales. Nada se sabe, y preguntar es peligroso.', succ: [] },
    { id: 'III', name: 'Hijos del Emperador', en: 'Emperor’s Children', st: 'traitor', mark: M.gem, primarch: 'Fulgrim', world: 'Chemos', blurb: 'Buscaron la perfección hasta corromperse. Cayeron ante Slaanesh y hoy son bandas de guerra hedonistas en el Ojo del Terror.', succ: [] },
    { id: 'IV', name: 'Guerreros de Hierro', en: 'Iron Warriors', st: 'traitor', mark: M.hazard, primarch: 'Perturabo', world: 'Olympia', blurb: 'Maestros del asedio, amargados por la falta de gloria. Traicionaron al Imperio y perfeccionan la guerra de trincheras al servicio del Caos.', succ: [] },
    { id: 'V', name: 'Cicatrices Blancas', en: 'White Scars', st: 'loyal', mark: M.bolt, primarch: 'Jaghatai Khan', world: 'Chogoris', blurb: 'Jinetes veloces de las estepas de Chogoris. La guerra relámpago es su arte; ningún enemigo escapa a su caza.', succ: [S('Cicatrices Blancas', 'Capítulo'), S('Señores de la Tormenta'), S('Saqueadores'), S('Destructores', '2ª F · destruido'), S('Merodeadores'), S('Halcones Solares')] },
    { id: 'VI', name: 'Lobos Espaciales', en: 'Space Wolves', st: 'loyal', mark: M.fangs, primarch: 'Leman Russ', world: 'Fenris', blurb: 'Los ejecutores del Emperador, salvajes e indomables. Rechazaron dividirse; solo un capítulo sucesor fue creado, y acabó en tragedia.', succ: [S('Lobos Espaciales', 'Capítulo'), S('Hermanos del Lobo', '2ª F · disuelto')] },
    { id: 'VII', name: 'Puños Imperiales', en: 'Imperial Fists', st: 'loyal', mark: M.fist, primarch: 'Rogal Dorn', world: 'Terra', blurb: 'Defensores de Terra durante el Asedio. Maestros de la fortificación y padres de algunos de los capítulos más célebres del Imperio.', succ: [S('Puños Imperiales', 'Capítulo'), S('Puños Carmesíes'), S('Templarios Negros'), S('Excoriadores'), S('Puños Ejemplares'), S('Bebedores de Almas'), S('Verdugos'), S('Martillos de Dorn', 'Posterior'), S('Caballeros de Hierro')] },
    { id: 'VIII', name: 'Señores de la Noche', en: 'Night Lords', st: 'traitor', mark: M.terror, primarch: 'Konrad Curze', world: 'Nostramo', blurb: 'Impusieron el orden mediante el terror hasta que el terror fue su único credo. Hoy aterrorizan la galaxia como saqueadores sin dios.', succ: [] },
    { id: 'IX', name: 'Ángeles Sangrientos', en: 'Blood Angels', st: 'loyal', mark: M.drop, primarch: 'Sanguinius', world: 'Baal', blurb: 'Nobles y trágicos, marcados por la muerte de Sanguinius. Su linaje hereda la Sed Roja y la Furia Negra.', succ: [S('Ángeles Sangrientos', 'Capítulo'), S('Desgarradores de Carne'), S('Á. Encarnadinos'), S('Á. Sanguinos'), S('Á. Bermellón'), S('Bebedores de Sangre'), S('Devoradores de Carne'), S('Lamentadores', '21ª Fundación')] },
    { id: 'X', name: 'Manos de Hierro', en: 'Iron Hands', st: 'loyal', mark: M.hand, primarch: 'Ferrus Manus', world: 'Medusa', blurb: 'La carne es débil. Tras perder a su primarca en Istvaan V, reemplazan cuerpo y compasión por hierro frío.', succ: [S('Manos de Hierro', 'Capítulo'), S('Garras Rojas'), S('Zarpas de Bronce'), S('Hijos de Medusa', 'M36 · cisma'), S('Señores de Hierro')] },
    { id: 'XI', name: '██████', en: 'Registros eliminados', st: 'lost', mark: M.censor, primarch: 'Desconocido', world: 'Desconocido', blurb: 'La Undécima Legión no existe. Nunca existió. Los archivos así lo confirman.', succ: [] },
    { id: 'XII', name: 'Devoradores de Mundos', en: 'World Eaters', prev: 'Sabuesos de Guerra', st: 'traitor', mark: M.hazard, primarch: 'Angron', world: 'Nuceria', blurb: 'Berserkers esclavos de los Clavos Carniceros. Entregados a Khorne, solo conocen la sangre y los cráneos.', succ: [] },
    { id: 'XIII', name: 'Ultramarines', en: 'Ultramarines', st: 'loyal', mark: M.omega, primarch: 'Roboute Guilliman', world: 'Macragge', blurb: 'La legión más numerosa. Guilliman escribió el Codex Astartes y dio ejemplo dividiéndola: la mayoría de capítulos descienden de su semilla genética.', succ: [S('Ultramarines', 'Capítulo'), S('Novamarines'), S('Capítulo Génesis'), S('Águilas de la Perdición'), S('Mortifactores'), S('Cónsules Negros'), S('Cónsules Blancos'), S('Pretores de Orfeo'), S('Grifos Aulladores', 'Probable'), S('Capítulo Aurora'), S('Hijos de Orar'), S('Guadañas del Emperador'), S('Águilas Plateadas'), S('Libadores'), S('Marines Errantes', 'Probable')] },
    { id: 'XIV', name: 'Guardia de la Muerte', en: 'Death Guard', prev: 'Incursores del Crepúsculo', st: 'traitor', mark: M.plague, primarch: 'Mortarion', world: 'Barbarus', blurb: 'Infantería imparable corrompida por la Plaga del Destructor. Sirven a Nurgle como heraldos de la enfermedad.', succ: [] },
    { id: 'XV', name: 'Mil Hijos', en: 'Thousand Sons', st: 'traitor', mark: M.column, primarch: 'Magnus el Rojo', world: 'Prospero', blurb: 'Hechiceros condenados por su búsqueda del conocimiento. La Rubrica de Ahriman redujo a la mayoría a polvo dentro de sus armaduras.', succ: [] },
    { id: 'XVI', name: 'Hijos de Horus', en: 'Sons of Horus', prev: 'Lobos Lunares', st: 'traitor', mark: M.eye, primarch: 'Horus', world: 'Cthonia', blurb: 'La legión del Señor de la Guerra, origen de la Herejía. Tras su derrota renacieron como la Legión Negra de Abaddon.', succ: [] },
    { id: 'XVII', name: 'Portadores de la Palabra', en: 'Word Bearers', prev: 'Heraldos Imperiales', st: 'traitor', mark: M.book, primarch: 'Lorgar', world: 'Colchis', blurb: 'Los primeros en caer. Su fe desmedida encontró en el Caos los dioses que el Emperador les negó, y sembraron la Herejía.', succ: [] },
    { id: 'XVIII', name: 'Salamandras', en: 'Salamanders', st: 'loyal', mark: M.flame, primarch: 'Vulkan', world: 'Nocturne', blurb: 'Forjadores y protectores de la humanidad. Diezmados en Istvaan V; su semilla genética apenas produjo sucesores.', succ: [S('Salamandras', 'Capítulo'), S('Dragones Negros', '21ª F · disputado')] },
    { id: 'XIX', name: 'Guardia del Cuervo', en: 'Raven Guard', st: 'loyal', mark: M.wings, primarch: 'Corvus Corax', world: 'Deliverance', blurb: 'Señores de la sombra y la guerra encubierta. Casi aniquilados en Istvaan V, reconstruyeron su linaje desde las cenizas.', succ: [S('Guardia del Cuervo', 'Capítulo'), S('Guardia Negra'), S('Injuriadores'), S('Raptores')] },
    { id: 'XX', name: 'Legión Alfa', en: 'Alpha Legion', st: 'traitor', mark: M.alpha, primarch: 'Alpharius Omegon', world: 'Desconocido', blurb: 'Maestros del engaño y la infiltración. Nadie sabe con certeza por qué se volvieron traidores, ni si de verdad lo son.', succ: [] }
  ]

  const ORPHANS = [
    { n: 'Caballeros Grises', tag: 'M31 · clasificado' }, { n: 'Cuervos Sangrientos', tag: 'Rumor: XV' },
    { n: 'Legión de los Condenados', tag: 'M36 · espectral' }, { n: 'Minotauros', tag: 'Alto Senado' },
    { n: 'Escorpiones Rojos', tag: 'Desconocido' }, { n: 'Exorcistas', tag: 'Ordo Malleus' },
    { n: 'Leones Celestiales', tag: 'Disputado' }, { n: 'Carcharodons', tag: 'Rumor: XIX' },
    { n: 'Marines Malevolentes', tag: 'Desconocido' }, { n: 'Fantasmas Estelares', tag: 'Desconocido' },
    { n: 'Cráneos Plateados', tag: 'Desconocido' }
  ]

  const state = { sel: null, selChap: null, filter: 'all', zoom: 0.75 }

  const scroller = document.getElementById('gene-scroller')
  const sizer = document.getElementById('gene-sizer')
  const canvas = document.getElementById('gene-canvas')
  const edges = document.getElementById('gene-edges')
  const nodesEl = document.getElementById('gene-nodes')
  const panelEl = document.getElementById('gene-panel')

  // ---- construcción estática (una sola vez) ----
  const SVGNS = 'http://www.w3.org/2000/svg'
  const pathMeta = [] // { el, kind: 'root'|'legion', id, dash, col, lostMult }

  function addPath (d, meta) {
    const p = document.createElementNS(SVGNS, 'path')
    p.setAttribute('d', d)
    p.setAttribute('fill', 'none')
    p.setAttribute('stroke', meta.col || '#ffffff')
    if (meta.dash) p.setAttribute('stroke-dasharray', meta.dash)
    edges.appendChild(p)
    pathMeta.push({ el: p, ...meta })
  }

  function markSvg (l) {
    const m = l.mark
    return `<svg viewBox="0 0 48 48" width="44" height="44" style="display:block;margin:0 auto">
      <circle cx="24" cy="24" r="${m.ringR || 0}" fill="none" stroke="#ffffff" stroke-width="2.4"></circle>
      <circle cx="24" cy="${m.dotY || 24}" r="${m.dotR || 0}" fill="#ffffff"></circle>
      <polygon points="${m.p1 || '0,0'}" fill="${m.p1f || '#ffffff'}"></polygon>
      <polygon points="${m.p2 || '0,0'}" fill="${m.p2f || '#ffffff'}"></polygon>
    </svg>`
  }

  function build () {
    // raíz + bus horizontal
    addPath(`M956,52 L956,${busY}`, { kind: 'root' })
    addPath(`M${x(0)},${busY} L${x(19)},${busY}`, { kind: 'root' })

    let html = ''
    D.forEach((l, i) => {
      if (l.st === 'lost' && !SHOW_LOST) return
      const cx = x(i)
      addPath(`M${cx},${busY} L${cx},${legTop}`, { kind: 'legion', id: l.id })

      const badge = l.st === 'traitor' ? 'CAOS' : l.st === 'lost' ? 'EXPURGADA' : ''
      const badgeColor = l.st === 'traitor' ? CHT : '#6a6a72'
      html += `<div class="gene-lg" data-lg="${l.id}" title="${l.en} · ${l.primarch}" style="position:absolute;left:${cx - 44}px;top:${legTop}px;width:88px;text-align:center;cursor:pointer">
        <span data-mark>${markSvg(l)}</span>
        <div style="font-family:'Cinzel',serif;font-size:12px;color:#9a9aa2;margin-top:6px">${l.id}</div>
        <div style="font-family:'Cinzel',serif;font-size:11.5px;font-weight:600;line-height:1.25;color:#ffffff;margin-top:2px">${l.name}</div>
        <div style="font-size:8.5px;font-style:italic;color:#7a7a82;margin-top:2px;line-height:1.3">${l.prev ? 'antes ' + l.prev : ''}</div>
        <div style="font-size:8px;letter-spacing:0.24em;margin-top:3px;color:${badgeColor}">${badge}</div>
      </div>`

      if (l.st === 'traitor') {
        addPath(`M${cx},${legBot} L${cx},${wbY}`, { kind: 'legion', id: l.id, dash: '5 5', col: CH })
        const wname = l.id === 'XVI' ? 'Legión Negra' : l.name
        html += `<div class="gene-wb" data-wb="${l.id}" style="position:absolute;left:${cx - 43}px;top:${wbY}px;width:86px;box-sizing:border-box;padding:6px 4px;text-align:center;background:#100b0b;border:1px dashed #4a2723;border-radius:2px;cursor:pointer">
          <div style="font-size:10px;line-height:1.25;color:#e8e6e0">${wname}</div>
          <div style="font-size:8px;letter-spacing:0.14em;color:${CHT};margin-top:3px">CAOS · M41</div>
        </div>`
      } else if (l.st === 'lost') {
        addPath(`M${cx},${legBot} L${cx},268`, { kind: 'legion', id: l.id, dash: '2 4', lost: true })
        html += `<div class="gene-term" data-term="${l.id}" style="position:absolute;left:${cx - 44}px;top:262px;width:88px;text-align:center;font-size:8.5px;letter-spacing:0.18em;color:#7a7a82">ELIMINADA</div>`
      } else {
        const maxRows = 9
        const n0 = Math.min(l.succ.length, maxRows)
        addPath(`M${cx},${legBot} L${cx},${rowY0 + (n0 - 1) * rowH + 23}`, { kind: 'legion', id: l.id })
        if (l.succ.length > maxRows) {
          const n1 = l.succ.length - maxRows
          addPath(`M${cx},${rowY0 - 16} L${cx + 90},${rowY0 - 16} L${cx + 90},${rowY0 + (n1 - 1) * rowH + 23}`, { kind: 'legion', id: l.id })
        }
        l.succ.forEach((s, k) => {
          const col = Math.floor(k / maxRows), row = k % maxRows
          html += `<div class="gene-chap" data-chap="${l.id}" data-name="${s.n}" style="position:absolute;left:${cx - 43 + col * 90}px;top:${rowY0 + row * rowH}px;width:86px;box-sizing:border-box;padding:6px 4px;text-align:center;background:#0c0d10;border:1px solid #2e2e36;border-radius:2px;cursor:pointer">
            <div style="font-size:10px;line-height:1.25;color:#e8e6e0">${s.n}</div>
            <div style="font-size:8px;letter-spacing:0.14em;color:#6a6a72;margin-top:3px">${s.tag}</div>
          </div>`
        })
      }
    })

    ORPHANS.forEach((s, i) => {
      html += `<div class="gene-chap" data-orphan="1" data-name="${s.n}" style="position:absolute;left:${323 + i * 118}px;top:1090px;width:86px;box-sizing:border-box;padding:6px 4px;text-align:center;background:#0c0d10;border:1px dashed #2e2e36;border-radius:2px;cursor:pointer">
        <div style="font-size:10px;line-height:1.25;color:#e8e6e0">${s.n}</div>
        <div style="font-size:8px;letter-spacing:0.14em;color:#6a6a72;margin-top:3px">${s.tag}</div>
      </div>`
    })

    nodesEl.innerHTML = html
  }

  // ---- estado → estilos ----
  function vis (l) {
    if (state.sel) return state.sel === l.id ? 1 : 0.12
    if (state.filter === 'loyal' && l.st !== 'loyal') return 0.15
    if (state.filter === 'traitor' && l.st !== 'traitor') return 0.15
    return 1
  }

  function panelData () {
    const sel = state.sel
    if (sel === '?') {
      return {
        sup: 'ADEPTUS ASTARTES', name: 'Origen desconocido', en: 'Founding unknown', prevLine: '',
        primarch: 'Desconocido', world: 'Diversos', statusLabel: 'Leales · linaje sin confirmar', statusColor: '#c8c6c0',
        blurb: 'Decenas de fundaciones se han sucedido a lo largo de diez milenios, y los registros de muchos capítulos se han perdido, censurado o clasificado. De estos guerreros se conoce su servicio, pero no la legión de la que desciende su semilla genética.',
        succ: ORPHANS.map(o => ({ n: o.n, tag: o.tag })), hasSucc: true
      }
    }
    const l = D.find(d => d.id === sel)
    if (!l) return null
    return {
      sup: `${l.id} LEGIÓN`, name: l.name, en: l.en,
      prevLine: l.prev ? `Antes de la Herejía: ${l.prev}` : '',
      primarch: l.primarch, world: l.world,
      statusLabel: l.st === 'loyal' ? 'Leal al Emperador' : l.st === 'traitor' ? 'Traidora — Caos' : 'Desconocida',
      statusColor: l.st === 'traitor' ? CHT : '#c8c6c0',
      blurb: l.blurb, succ: l.succ, hasSucc: l.succ.length > 0
    }
  }

  function renderPanel () {
    let p = panelData()
    if (p && state.selChap) {
      const l = D.find(d => d.id === state.sel)
      p = { ...p, name: state.selChap, en: state.sel === '?' ? 'Capítulo · origen desconocido' : `Capítulo · linaje ${l.name}` }
    }
    if (!p) { panelEl.style.display = 'none'; panelEl.innerHTML = ''; return }
    let succHtml = ''
    if (p.hasSucc) {
      succHtml = `<div style="font-size:10px;letter-spacing:0.2em;color:#6a6a72;margin-bottom:8px">LINAJE CONOCIDO</div>` +
        p.succ.map(s => `<div style="display:flex;justify-content:space-between;gap:10px;font-size:12.5px;padding:5px 0;border-bottom:1px solid #1c1c22">
          <span style="color:#e8e6e0">${s.n}</span><span style="color:#6a6a72;font-size:10px;white-space:nowrap">${s.tag}</span>
        </div>`).join('')
    }
    panelEl.innerHTML = `
      <button class="gene-x" data-close>✕</button>
      <div style="font-family:'Cinzel',serif;font-size:13px;color:#8a8a92">${p.sup}</div>
      <h2 style="font-family:'Cinzel',serif;font-size:21px;font-weight:700;color:#ffffff;margin:4px 0 2px">${p.name}</h2>
      <div style="font-size:11px;letter-spacing:0.12em;color:#6a6a72;text-transform:uppercase">${p.en}</div>
      <div style="font-size:12px;font-style:italic;color:#9a9aa2;margin-top:6px">${p.prevLine || ''}</div>
      <div style="display:grid;grid-template-columns:auto 1fr;gap:5px 14px;font-size:12.5px;margin:16px 0;color:#c8c6c0">
        <span style="color:#6a6a72">Primarca</span><span>${p.primarch}</span>
        <span style="color:#6a6a72">Mundo</span><span>${p.world}</span>
        <span style="color:#6a6a72">Lealtad</span><span style="color:${p.statusColor}">${p.statusLabel}</span>
      </div>
      <p style="font-size:13px;line-height:1.6;color:#a8a8b0;margin:0 0 16px;text-wrap:pretty">${p.blurb}</p>
      ${succHtml}`
    panelEl.style.display = 'block'
  }

  function update () {
    const { sel, filter, zoom } = state
    const opById = {}
    D.forEach(l => { opById[l.id] = vis(l) })

    // aristas
    pathMeta.forEach(m => {
      if (m.kind === 'root') {
        m.el.setAttribute('opacity', LINE_BASE * (sel ? 0.12 : 1))
        m.el.setAttribute('stroke-width', 1.2)
        m.el.style.filter = ''
        return
      }
      const selected = sel === m.id
      let lo = selected ? 0.95 : LINE_BASE * opById[m.id]
      if (m.lost) lo *= 0.7
      m.el.setAttribute('opacity', lo)
      m.el.setAttribute('stroke-width', m.lost ? 1 : (selected ? 2 : 1.2))
      m.el.style.filter = selected ? 'drop-shadow(0 0 5px rgba(255,255,255,0.8))' : ''
    })

    // legiones
    nodesEl.querySelectorAll('[data-lg]').forEach(el => {
      const id = el.getAttribute('data-lg')
      el.style.opacity = opById[id]
      const svg = el.querySelector('svg')
      if (svg) svg.style.filter = sel === id ? 'drop-shadow(0 0 8px rgba(255,255,255,0.7))' : 'none'
    })
    // bandas de guerra
    nodesEl.querySelectorAll('[data-wb]').forEach(el => {
      const id = el.getAttribute('data-wb')
      el.style.opacity = opById[id]
      el.style.borderColor = sel === id ? CHT : '#4a2723'
    })
    // terminadores "ELIMINADA"
    nodesEl.querySelectorAll('[data-term]').forEach(el => {
      el.style.opacity = opById[el.getAttribute('data-term')] * 0.8
    })
    // capítulos con linaje
    nodesEl.querySelectorAll('[data-chap]').forEach(el => {
      const id = el.getAttribute('data-chap')
      el.style.opacity = opById[id]
      el.style.borderColor = sel === id ? '#c8c6c0' : '#2e2e36'
    })
    // capítulos huérfanos
    const orphOp = sel ? (sel === '?' ? 1 : 0.12) : (filter === 'traitor' ? 0.15 : 1)
    nodesEl.querySelectorAll('[data-orphan]').forEach(el => {
      el.style.opacity = orphOp
      el.style.borderColor = sel === '?' ? '#c8c6c0' : '#2e2e36'
    })

    // botones de filtro
    document.querySelectorAll('.gene-fbtn').forEach(b => {
      const active = b.getAttribute('data-filter') === filter
      b.style.background = active ? '#e8e6e0' : 'transparent'
      b.style.color = active ? '#080809' : '#e8e6e0'
      b.style.borderColor = active ? '#e8e6e0' : '#34343c'
    })

    // zoom
    sizer.style.width = Math.round(W * zoom) + 'px'
    sizer.style.height = (Math.round(H * zoom) + 40) + 'px'
    canvas.style.transform = `scale(${zoom})`

    renderPanel()
  }

  function setState (patch) { Object.assign(state, patch); update() }
  function fit () {
    const w = Math.min(window.innerWidth - 24, W)
    setState({ zoom: Math.max(0.4, Math.min(1, w / W)) })
  }

  // ---- interacción ----
  canvas.addEventListener('click', (e) => {
    const lg = e.target.closest('[data-lg]')
    if (lg) {
      const id = lg.getAttribute('data-lg')
      setState({ sel: state.sel === id ? null : id, selChap: null })
      e.stopPropagation(); return
    }
    const wb = e.target.closest('[data-wb]')
    if (wb) { setState({ sel: wb.getAttribute('data-wb') }); e.stopPropagation(); return }
    const chap = e.target.closest('[data-chap]')
    if (chap) { setState({ sel: chap.getAttribute('data-chap'), selChap: chap.getAttribute('data-name') }); e.stopPropagation(); return }
    const orph = e.target.closest('[data-orphan]')
    if (orph) { setState({ sel: '?', selChap: orph.getAttribute('data-name') }); e.stopPropagation(); return }
    setState({ sel: null, selChap: null })
  })

  panelEl.addEventListener('click', (e) => {
    if (e.target.closest('[data-close]')) setState({ sel: null, selChap: null })
  })

  document.querySelectorAll('.gene-fbtn').forEach(b => {
    b.addEventListener('click', () => setState({ filter: b.getAttribute('data-filter'), sel: null, selChap: null }))
  })
  document.getElementById('gene-zin').addEventListener('click', () => setState({ zoom: Math.min(1.6, state.zoom + 0.12) }))
  document.getElementById('gene-zout').addEventListener('click', () => setState({ zoom: Math.max(0.3, state.zoom - 0.12) }))
  document.getElementById('gene-zfit').addEventListener('click', fit)

  scroller.addEventListener('mousedown', (e) => {
    const sx = e.clientX, sl = scroller.scrollLeft
    const mv = (ev) => { scroller.scrollLeft = sl - (ev.clientX - sx) }
    const up = () => {
      window.removeEventListener('mousemove', mv)
      window.removeEventListener('mouseup', up)
      scroller.style.cursor = 'grab'
    }
    scroller.style.cursor = 'grabbing'
    window.addEventListener('mousemove', mv)
    window.addEventListener('mouseup', up)
  })

  build()
  fit()
</script>
