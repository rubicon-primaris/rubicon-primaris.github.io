        <div style="font-family:'Cinzel',serif;font-size:13px;color:#9a9aa2;margin-top:6px">${l.id}</div>
        <div style="font-family:'Cinzel',serif;font-size:13px;font-weight:600;line-height:1.25;color:#ffffff;margin-top:2px">${l.name}</div>
        <div style="font-size:10px;font-style:italic;color:#7a7a82;margin-top:2px;line-height:1.3">${l.prev ? 'antes ' + l.prev : ''}</div>
        <div style="font-size:9px;letter-spacing:0.24em;margin-top:3px;color:${badgeColor}">${badge}</div>
        ${dotsHtml(chapCols(l.name), 9, 5, 'margin-top:4px')}
      </div>`

      if (l.st === 'traitor') {
        addPath(`M${cx},${Y(180)} L${cx},${Y(270)}`, { kind: 'legion', id: l.id, dash: '5 5', col: CH })
        const wname = l.id === 'XVI' ? 'Legión Negra' : l.name
        const wbTop = up ? BUS - 270 - cardH : BUS + 270
        html += `<div class="gene-wb" data-wb="${l.id}" style="position:absolute;left:${cx - 55}px;top:${wbTop}px;width:110px;height:${cardH}px;box-sizing:border-box;padding:6px 4px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;background:#100b0b;border:1px dashed #4a2723;border-radius:2px;cursor:pointer">
          ${dotsHtml(chapCols(wname), 8, 4, 'margin-bottom:4px')}
          <div style="font-size:12px;line-height:1.3;color:#e8e6e0">${wname}</div>
          <div style="font-size:9px;letter-spacing:0.14em;color:${CHT};margin-top:4px">CAOS · M41</div>
        </div>`
      } else if (l.st === 'lost') {
        addPath(`M${cx},${Y(180)} L${cx},${Y(196)}`, { kind: 'legion', id: l.id, dash: '2 4', lost: true })
        const termTop = up ? BUS - 202 : BUS + 190
        html += `<div class="gene-term" data-term="${l.id}" style="position:absolute;left:${cx - 56}px;top:${termTop}px;width:112px;text-align:center;font-size:10px;letter-spacing:0.18em;color:#7a7a82">ELIMINADA</div>`
      } else {
        const maxRows = 9
        const n0 = Math.min(l.succ.length, maxRows)
        addPath(`M${cx},${Y(180)} L${cx},${Y(400 + (n0 - 1) * rowH + cardH / 2)}`, { kind: 'legion', id: l.id })
        if (l.succ.length > maxRows) {
          const n1 = l.succ.length - maxRows
          addPath(`M${cx},${Y(382)} L${cx + 116},${Y(382)} L${cx + 116},${Y(400 + (n1 - 1) * rowH + cardH / 2)}`, { kind: 'legion', id: l.id })
        }
        l.succ.forEach((s, k) => {
          const col = Math.floor(k / maxRows), row = k % maxRows
          const top = up ? BUS - (400 + cardH) - row * rowH : BUS + 400 + row * rowH
          html += `<div class="gene-chap" data-chap="${l.id}" data-name="${s.n}" style="position:absolute;left:${cx - 55 + col * 116}px;top:${top}px;width:110px;height:${cardH}px;box-sizing:border-box;padding:6px 4px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;background:#0c0d10;border:1px solid #2e2e36;border-radius:2px;cursor:pointer">
            ${dotsHtml(chapCols(s.n), 8, 4, 'margin-bottom:4px')}
            <div style="font-size:12px;line-height:1.3;color:#e8e6e0">${s.n}</div>
            <div style="font-size:9px;letter-spacing:0.14em;color:#6a6a72;margin-top:4px">${s.tag}</div>
          </div>`
        })
      }
    })

    // huerfanos en la franja central: leales a la izquierda y arriba-derecha;
    // los caidos al Caos, abajo a la derecha del Emperador
    const ORPH_POS = [
      [56, CY1 + 30], [180, CY1 + 30], [304, CY1 + 30], [428, CY1 + 30],
      [56, CY1 + 114], [180, CY1 + 114], [304, CY1 + 114], [428, CY1 + 114],
      [56, CY1 + 198], [180, CY1 + 198], [304, CY1 + 198],
      [880, CY1 + 30], [1004, CY1 + 30],
      [880, CY1 + 114], [1004, CY1 + 114]
    ]
    ORPHANS.forEach((s, i) => {
      const [left, top] = ORPH_POS[i]
      const cls = s.fallen ? 'gene-wb' : 'gene-chap'
      const box = s.fallen ? 'background:#100b0b;border:1px dashed #4a2723' : 'background:#0c0d10;border:1px dashed #2e2e36'
      const tagColor = s.fallen ? CHT : '#6a6a72'
      html += `<div class="${cls}" data-orphan="1" ${s.fallen ? 'data-fallen="1"' : ''} data-name="${s.n}" style="position:absolute;left:${left}px;top:${top}px;width:110px;height:${cardH}px;box-sizing:border-box;padding:6px 4px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;${box};border-radius:2px;cursor:pointer">
        ${dotsHtml(chapCols(s.n), 8, 4, 'margin-bottom:4px')}
        <div style="font-size:12px;line-height:1.3;color:#e8e6e0">${s.n}</div>
        <div style="font-size:9px;letter-spacing:0.14em;color:${tagColor};margin-top:4px">${s.tag}</div>
      </div>`
    })

    // Adeptus Custodes: a la derecha del Emperador. No son Astartes — son la
    // guardia personal del Emperador, creados por su propia mano.
    addPath(`M${W / 2},${CY1 + 120} L740,${CY1 + 120}`, { kind: 'root', col: '#8a6f2a' })
    html += `<div class="gene-cust" data-custodes="1" style="position:absolute;left:734px;top:${CY1 + 84}px;width:110px;height:${cardH}px;box-sizing:border-box;padding:6px 4px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;background:#14100a;border:1px solid #8a6f2a;border-radius:2px;cursor:pointer">
      ${dotsHtml(['#c9a227', '#8a1f1f'], 8, 4, 'margin-bottom:4px')}
      <div style="font-size:12px;line-height:1.3;color:#e8d5a0">Adeptus Custodes</div>
      <div style="font-size:9px;letter-spacing:0.14em;color:#a08432;margin-top:4px">LOS DIEZ MIL</div>
    </div>`

    nodesEl.innerHTML = html
  }

  // ---- estado → estilos ----
  function vis (l) {
    if (state.sel) return state.sel === l.id ? 1 : 0.12
    if (state.filter === 'loyal' && l.st !== 'loyal') return 0.15
    if (state.filter === 'traitor' && l.st !== 'traitor') return 0.15
    return 1
  }

  function panelData () {
    const sel = state.sel
    if (sel === 'CUSTODES') {
      return {
        sup: 'AGENTES DEL TRONO', name: 'Adeptus Custodes', en: 'Legio Custodes · Los Diez Mil', prevLine: '',
        primarch: 'Ninguno — obra del propio Emperador', world: 'Terra — Palacio Imperial',
        statusLabel: 'Leales · Guardia del Emperador', statusColor: '#e8d5a0',
        master: 'Trajann Valoris', masterLabel: 'Capitán General',
        cols: ['#c9a227', '#8a1f1f'], hasCols: true,
        primaris: 'No aplica — los Custodes no son Astartes',
        blurb: 'No son Astartes: cada Custodio es una obra única, forjada por la ciencia del propio Emperador y superior a cualquier marine espacial. Durante diez milenios custodiaron el Trono Dorado sin abandonar Terra; tras la apertura de la Gran Grieta, Trajann Valoris los ha devuelto a los campos de batalla de la galaxia.',
        succ: [], hasSucc: false
      }
    }
    if (sel === '?') {
      return {
        sup: 'ADEPTUS ASTARTES', name: 'Origen desconocido', en: 'Founding unknown', prevLine: '',
        primarch: 'Desconocido', world: 'Diversos', statusLabel: 'Leales · linaje sin confirmar', statusColor: '#c8c6c0',
        blurb: 'Decenas de fundaciones se han sucedido a lo largo de diez milenios, y los registros de muchos capítulos se han perdido, censurado o clasificado. De estos guerreros se conoce su servicio, pero no la legión de la que desciende su semilla genética.',
        succ: ORPHANS.map(o => ({ n: o.n, tag: o.tag, c: chapCols(o.n) })), hasSucc: true,
        master: 'Sin registros', masterLabel: 'Señor del Capítulo',
        primaris: 'Variable — la mayoría recibió refuerzos de la Cruzada Indomitus'
      }
    }
    const l = D.find(d => d.id === sel)
    if (!l) return null
    return {
      sup: `${l.id} LEGIÓN`, name: l.name, en: l.en,
      prevLine: l.prev ? `Antes de la Herejía: ${l.prev}` : '',
      primarch: l.primarch, world: l.world,
      statusLabel: l.st === 'loyal' ? 'Leal al Emperador' : l.st === 'traitor' ? 'Traidora — Caos' : 'Desconocida',
      statusColor: l.st === 'traitor' ? CHT : '#c8c6c0',
      blurb: l.blurb, succ: l.succ.map(s => ({ ...s, c: chapCols(s.n) })), hasSucc: l.succ.length > 0,
      cols: chapCols(l.name), hasCols: chapCols(l.name).length > 0,
      master: (CI[l.name] || {}).m || 'Desconocido',
      masterLabel: l.st === 'traitor' ? 'Señor de la Guerra' : 'Señor del Capítulo',
      primaris: l.st === 'loyal' ? 'Mixto — refuerzos de la Cruzada Indomitus en todo el linaje'
        : l.st === 'traitor' ? 'Ninguno — las legiones traidoras no cruzaron el Rubicón' : undefined,
      hasPrim: true, primFate: PR[l.id][0], primBlurb: PR[l.id][1],
      primFateColor: l.st === 'traitor' ? CHT : '#c8c6c0'
    }
  }

  let lastPanelKey = null

  function renderPanel () {
    let p = panelData()
    if (p && state.selChap) {
      const l = D.find(d => d.id === state.sel)
      const info = CI[state.selChap] || {}
      const fallen = !!(ORPHANS.find(o => o.n === state.selChap) || {}).fallen
      p = {
        ...p, name: state.selChap,
        en: state.sel === '?' ? 'Capítulo · origen desconocido' : `Capítulo · linaje ${l.name}`,
        blurb: info.d || p.blurb, cols: info.c || [], hasCols: (info.c || []).length > 0,
        master: info.m || 'Sin registros', masterLabel: fallen ? 'Señor de la Guerra' : 'Señor del Capítulo', hasPrim: false,
        hasSucc: state.sel !== '?' && p.hasSucc,
        primaris: primarisOf(state.selChap),
        statusLabel: fallen ? 'Renegado — Caos' : p.statusLabel,
        statusColor: fallen ? CHT : p.statusColor
      }
    }
    if (!p) { panelEl.style.display = 'none'; panelEl.innerHTML = ''; lastPanelKey = null; return }
    let colsHtml = ''
    if (p.hasCols) {
      colsHtml = `<div style="display:flex;gap:8px;margin-top:12px;align-items:center">` +
        p.cols.map(c => `<span style="width:20px;height:20px;border-radius:50%;background:${c};border:1px solid #3a3a42;box-shadow:inset 0 0 5px rgba(0,0,0,0.45)"></span>`).join('') +
        `<span style="font-size:9.5px;letter-spacing:0.16em;color:#6a6a72">COLORES DEL CAPÍTULO</span></div>`
    }
    let primHtml = ''
    if (p.hasPrim) {
      primHtml = `<div style="border-top:1px solid #1c1c22;padding-top:14px;margin-bottom:16px">
        <div style="font-size:10px;letter-spacing:0.2em;color:#6a6a72;margin-bottom:6px">EL PRIMARCA</div>
        <div style="font-family:'Cinzel',serif;font-size:15px;font-weight:600;color:#ffffff">${p.primarch}</div>
        <div style="font-size:10.5px;letter-spacing:0.1em;color:${p.primFateColor};text-transform:uppercase;margin:2px 0 8px">${p.primFate}</div>
        <p style="font-size:12.5px;line-height:1.6;color:#a8a8b0;margin:0;text-wrap:pretty">${p.primBlurb}</p>
      </div>`
    }
    let palHtml = ''
    if (p.hasCols) {
      palHtml = `<div style="border-top:1px solid #1c1c22;padding-top:14px;margin-bottom:16px">
        <div style="font-size:10px;letter-spacing:0.2em;color:#6a6a72;margin-bottom:8px">COLORES · PINTURAS CITADEL</div>` +
        colorNames(p.name, p.cols).map(x => `<div style="display:flex;align-items:center;gap:10px;font-size:12.5px;padding:4px 0">
          <span style="width:16px;height:16px;border-radius:50%;background:${x.c};border:1px solid #3a3a42;box-shadow:inset 0 0 4px rgba(0,0,0,0.45);flex-shrink:0"></span>
          <span style="color:#c8c6c0">${x.n}</span>
        </div>`).join('') + '</div>'
    }
    let succHtml = ''
    if (p.hasSucc) {
      succHtml = `<div style="font-size:10px;letter-spacing:0.2em;color:#6a6a72;margin-bottom:8px">LINAJE CONOCIDO</div>` +
        p.succ.map(s => `<div style="display:flex;justify-content:space-between;gap:10px;font-size:12.5px;padding:5px 0;border-bottom:1px solid #1c1c22">
          <span style="display:flex;align-items:center;gap:6px;color:#e8e6e0">${(s.c || []).map(c => `<span style="width:9px;height:9px;border-radius:50%;background:${c};border:1px solid #3a3a42;flex-shrink:0"></span>`).join('')}${s.n}</span><span style="color:#6a6a72;font-size:10px;white-space:nowrap">${s.tag}</span>
        </div>`).join('')
    }
    panelEl.innerHTML = `
      <button class="gene-x" data-close>✕</button>
      <div style="font-family:'Cinzel',serif;font-size:13px;color:#8a8a92">${p.sup}</div>
      <h2 style="font-family:'Cinzel',serif;font-size:21px;font-weight:700;color:#ffffff;margin:4px 0 2px">${p.name}</h2>
      <div style="font-size:11px;letter-spacing:0.12em;color:#6a6a72;text-transform:uppercase">${p.en}</div>
      ${colsHtml}
      <div style="font-size:12px;font-style:italic;color:#9a9aa2;margin-top:6px">${p.prevLine || ''}</div>
      <div style="display:grid;grid-template-columns:auto 1fr;gap:5px 14px;font-size:12.5px;margin:16px 0;color:#c8c6c0">
        <span style="color:#6a6a72">Primarca</span><span>${p.primarch}</span>
        <span style="color:#6a6a72">Mundo</span><span>${p.world}</span>
        <span style="color:#6a6a72">Lealtad</span><span style="color:${p.statusColor}">${p.statusLabel}</span>
        <span style="color:#6a6a72">${p.masterLabel}</span><span>${p.master}</span>
        ${p.primaris ? `<span style="color:#6a6a72">Primaris</span><span>${p.primaris}</span>` : ''}
      </div>
      <p style="font-size:13px;line-height:1.6;color:#a8a8b0;margin:0 0 16px;text-wrap:pretty">${p.blurb}</p>
      ${primHtml}
      ${palHtml}
      ${succHtml}`
    panelEl.style.display = 'block'
    // reanima la entrada del panel cada vez que cambia la seleccion
    const key = state.sel + '|' + (state.selChap || '')
    if (key !== lastPanelKey) {
      panelEl.classList.remove('gene-panel-in')
      void panelEl.offsetWidth
      panelEl.classList.add('gene-panel-in')
      lastPanelKey = key
    }
  }

  function update () {
    const { sel, filter, zoom } = state
    const opById = {}
    D.forEach(l => { opById[l.id] = vis(l) })

    // aristas
    pathMeta.forEach(m => {
      if (m.kind === 'root') {
        m.el.setAttribute('opacity', LINE_BASE * (sel ? 0.12 : 1))
        m.el.setAttribute('stroke-width', 1.2)
        m.el.style.filter = ''
        return
      }
      const selected = sel === m.id
      let lo = selected ? 0.95 : LINE_BASE * opById[m.id]
      if (m.lost) lo *= 0.7
      m.el.setAttribute('opacity', lo)
      m.el.setAttribute('stroke-width', m.lost ? 1 : (selected ? 2 : 1.2))
      m.el.style.filter = selected ? 'drop-shadow(0 0 5px rgba(255,255,255,0.8))' : ''
    })

    // legiones
    nodesEl.querySelectorAll('[data-lg]').forEach(el => {
      const id = el.getAttribute('data-lg')
      el.style.opacity = opById[id]
      const mark = el.querySelector('svg, img')
      if (mark) mark.style.filter = sel === id ? 'drop-shadow(0 0 8px rgba(255,255,255,0.7))' : 'none'
    })
    // bandas de guerra
    nodesEl.querySelectorAll('[data-wb]').forEach(el => {
      const id = el.getAttribute('data-wb')
      el.style.opacity = opById[id]
      el.style.borderColor = sel === id ? CHT : '#4a2723'
    })
    // terminadores "ELIMINADA"
    nodesEl.querySelectorAll('[data-term]').forEach(el => {
      el.style.opacity = opById[el.getAttribute('data-term')] * 0.8
    })
    // capítulos con linaje
    nodesEl.querySelectorAll('[data-chap]').forEach(el => {
      const id = el.getAttribute('data-chap')
      el.style.opacity = opById[id]
      el.style.borderColor = sel === id ? '#c8c6c0' : '#2e2e36'
    })
    // capítulos huérfanos (los caidos siguen el filtro de traidoras)
    nodesEl.querySelectorAll('[data-orphan]').forEach(el => {
      const fallen = el.hasAttribute('data-fallen')
      el.style.opacity = sel ? (sel === '?' ? 1 : 0.12) : (filter === (fallen ? 'loyal' : 'traitor') ? 0.15 : 1)
      el.style.borderColor = sel === '?' ? (fallen ? CHT : '#c8c6c0') : (fallen ? '#4a2723' : '#2e2e36')
    })
    // Adeptus Custodes
    const custEl = nodesEl.querySelector('[data-custodes]')
    if (custEl) {
      custEl.style.opacity = sel ? (sel === 'CUSTODES' ? 1 : 0.12) : (filter === 'traitor' ? 0.15 : 1)
      custEl.style.borderColor = sel === 'CUSTODES' ? '#e0b31f' : '#8a6f2a'
    }

    // botones de filtro
    document.querySelectorAll('.gene-fbtn').forEach(b => {
      const active = b.getAttribute('data-filter') === filter
      b.style.background = active ? '#e8e6e0' : 'transparent'
      b.style.color = active ? '#080809' : '#e8e6e0'
      b.style.borderColor = active ? '#e8e6e0' : '#34343c'
    })

    // zoom
    sizer.style.width = Math.round(W * zoom) + 'px'
    sizer.style.height = (Math.round(H * zoom) + 40) + 'px'
    canvas.style.transform = `scale(${zoom})`

    renderPanel()
  }

  function setState (patch) { Object.assign(state, patch); update() }

  // AJUSTAR = vista general: encoge hasta que quepa (con un suelo de legibilidad)
  function fit () {
    const w = Math.min(window.innerWidth - 24, W)
    const minZ = window.innerWidth < 640 ? 0.5 : 0.32
    setState({ zoom: Math.max(minZ, Math.min(1, w / W)) })
  }

  // Vista inicial: zoom legible y arranque en la franja central (el Emperador);
  // lo que no quepa se recorre con arrastre / scroll tactil
  function initView () {
    const w = Math.min(window.innerWidth - 24, W)
    setState({ zoom: Math.max(0.8, Math.min(1, w / W)) })
    if (W * state.zoom > scroller.clientWidth) {
      scroller.scrollLeft = (W / 2) * state.zoom - scroller.clientWidth / 2
    }
    // entrada cinematica: desde la cabecera, scroll suave hasta dejar a Terra en el centro
    const topPage = scroller.getBoundingClientRect().top + window.scrollY + 8 + ((CY1 + CY2) / 2) * state.zoom
    const target = Math.max(0, topPage - window.innerHeight * 0.5)
    setTimeout(() => window.scrollTo({ top: target, behavior: 'smooth' }), 350)
  }

  // Centra suavemente la legion seleccionada (dejando sitio al panel en escritorio)
  function centerLegion (id) {
    const i = D.findIndex(d => d.id === id)
    if (i < 0) return
    if (W * state.zoom > scroller.clientWidth) {
      const panelW = window.innerWidth > 900 ? 320 : 0
      scroller.scrollTo({ left: x(i % 10) * state.zoom - (scroller.clientWidth - panelW) / 2, behavior: 'smooth' })
    }
    const node = nodesEl.querySelector(`[data-lg="${id}"]`)
    if (node) {
      // banda superior: el linaje crece hacia arriba, deja el nodo abajo; banda inferior, al reves
      const anchor = i < 10 ? 0.72 : 0.25
      const r = node.getBoundingClientRect()
      window.scrollBy({ top: r.top - window.innerHeight * anchor, behavior: 'smooth' })
    }
  }

  // ---- interacción ----
  canvas.addEventListener('click', (e) => {
    const lg = e.target.closest('[data-lg]')
    if (lg) {
      const id = lg.getAttribute('data-lg')
      const selecting = state.sel !== id
      setState({ sel: selecting ? id : null, selChap: null })
      if (selecting) centerLegion(id)
      e.stopPropagation(); return
    }
    const wb = e.target.closest('[data-wb]')
    if (wb) {
      const id = wb.getAttribute('data-wb')
      setState({ sel: id }); centerLegion(id)
      e.stopPropagation(); return
    }
    const chap = e.target.closest('[data-chap]')
    if (chap) {
      const id = chap.getAttribute('data-chap')
      setState({ sel: id, selChap: chap.getAttribute('data-name') }); centerLegion(id)
      e.stopPropagation(); return
    }
    const orph = e.target.closest('[data-orphan]')
    if (orph) { setState({ sel: '?', selChap: orph.getAttribute('data-name') }); e.stopPropagation(); return }
    const cust = e.target.closest('[data-custodes]')
    if (cust) { setState({ sel: 'CUSTODES', selChap: null }); e.stopPropagation(); return }
    setState({ sel: null, selChap: null })
  })

  panelEl.addEventListener('click', (e) => {
    if (e.target.closest('[data-close]')) setState({ sel: null, selChap: null })
  })

  document.querySelectorAll('.gene-fbtn').forEach(b => {
    b.addEventListener('click', () => setState({ filter: b.getAttribute('data-filter'), sel: null, selChap: null }))
  })
  document.getElementById('gene-zin').addEventListener('click', () => setState({ zoom: Math.min(1.6, state.zoom + 0.12) }))
  document.getElementById('gene-zout').addEventListener('click', () => setState({ zoom: Math.max(0.3, state.zoom - 0.12) }))
  document.getElementById('gene-zfit').addEventListener('click', fit)

  // arrastre en ambos ejes: horizontal sobre el lienzo y vertical sobre la pagina.
  // Zona muerta de 5px para no confundir un click con un arrastre.
  let dragMoved = false
  scroller.addEventListener('mousedown', (e) => {
    const sx = e.clientX, sy = e.clientY
    const sl = scroller.scrollLeft, st = window.scrollY
    dragMoved = false
    const mv = (ev) => {
      const dx = ev.clientX - sx, dy = ev.clientY - sy
      if (!dragMoved && Math.abs(dx) < 5 && Math.abs(dy) < 5) return
      dragMoved = true
      scroller.scrollLeft = sl - dx
      window.scrollTo(0, st - dy)
    }
    const up = () => {
      window.removeEventListener('mousemove', mv)
      window.removeEventListener('mouseup', up)
      scroller.style.cursor = 'grab'
    }
    scroller.style.cursor = 'grabbing'
    window.addEventListener('mousemove', mv)
    window.addEventListener('mouseup', up)
  })
  // tras un arrastre real, el click resultante no debe seleccionar ni deseleccionar nada
  scroller.addEventListener('click', (e) => {
    if (dragMoved) { e.stopPropagation(); dragMoved = false }
  }, true)

  build()
  initView()
</script>
