      const up = gi < 10                     // banda superior: legiones I–X
      const cx = x(gi % 10)
      const BUS = up ? CY1 : CY2
      const Y = (off) => up ? BUS - off : BUS + off   // offset alejandose del centro

      addPath(`M${cx},${BUS} L${cx},${Y(24)}`, { kind: 'legion', id: l.id })

      const badge = l.st === 'traitor' ? 'CAOS' : l.st === 'lost' ? 'EXPURGADA' : ''
      const badgeColor = l.st === 'traitor' ? CHT : '#6a6a72'
      const nodeTop = up ? BUS - 184 : BUS + 24
      html += `<div class="gene-lg" data-lg="${l.id}" title="${l.en} · ${l.primarch}" style="position:absolute;left:${cx - 56}px;top:${nodeTop}px;width:112px;text-align:center;cursor:pointer">
