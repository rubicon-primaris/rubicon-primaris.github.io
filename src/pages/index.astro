---
import Layout from '../layouts/Layout.astro'
import GalaxyMap from '../components/GalaxyMap.astro'

// Partículas deterministas (misma secuencia LCG que el diseño original, semilla 42)
const mkRnd = () => {
  let seed = 42
  return () => (seed = (seed * 16807) % 2147483647) / 2147483647
}
const rnd = mkRnd()

const stars = []
for (let i = 0; i < 60; i++) {
  stars.push({
    left: (rnd() * 100).toFixed(3),
    top: (rnd() * 100).toFixed(3),
    w: rnd() > 0.85 ? 2 : 1,
    h: rnd() > 0.85 ? 2 : 1,
    o: (0.15 + rnd() * 0.4).toFixed(3),
    dur: (4 + rnd() * 6).toFixed(1),
    delay: (rnd() * 6).toFixed(1),
  })
}

const ashes = []
for (let i = 0; i < 18; i++) {
  const warm = rnd() > 0.6
  ashes.push({
    warm,
    left: (rnd() * 100).toFixed(3),
    o: (0.12 + rnd() * 0.2).toFixed(3),
    drift: ((rnd() - 0.5) * 120).toFixed(0),
    dur: (22 + rnd() * 26).toFixed(1),
    delay: (-rnd() * 40).toFixed(1),
  })
}

// Brasas del hero (efecto "ceniza" del diseño Hero Cruzada, semilla 987)
const mkEmberRnd = () => {
  let seed = 987
  return () => (seed = (seed * 16807) % 2147483647) / 2147483647
}
const ernd = mkEmberRnd()
const embers = []
for (let i = 0; i < 45; i++) {
  embers.push({
    size: (1.5 + ernd() * 3.5).toFixed(2),
    left: (ernd() * 100).toFixed(3),
    dur: (7 + ernd() * 9).toFixed(2),
    delay: (-ernd() * 16).toFixed(2),
    sway: ((ernd() - 0.5) * 160).toFixed(0),
    warm: ernd() > 0.35,
  })
}

// pos centra al personaje en la card; zoom compensa las imágenes apaisadas (su cover queda
// limitado por la altura y no amplía al expandir la card) y origin fija el punto focal del zoom
const factions = [
  { name: 'Caos', image: '/images/home/faction-caos.jpg', pos: 'center 20%', zoom: true, origin: '50% 26%' },
  { name: 'Xenos', image: '/images/home/faction-xenos.png', pos: 'center 30%', zoom: true, origin: '50% 30%' },
  { name: 'Imperium', image: '/images/home/faction-imperium.png', pos: 'center 20%' },
]
---
<Layout>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;900&display=swap" />
  </Fragment>

  <main class="relative min-h-screen w-full bg-surface font-sans text-white">
    <div class="pointer-events-none fixed inset-0 z-[1] overflow-hidden">
      {stars.map((s) => (
        <span
          class="star absolute rounded-full bg-[#d6d3d1]"
          style={`left:${s.left}%;top:${s.top}%;width:${s.w}px;height:${s.h}px;--o:${s.o};animation:starTwinkle ${s.dur}s ease-in-out ${s.delay}s infinite`}
        ></span>
      ))}
      {ashes.map((a) => (
        <span
          class="absolute top-0 h-[2px] w-[2px] rounded-full blur-[0.5px]"
          style={`left:${a.left}%;background:${a.warm ? 'rgba(235,94,40,.7)' : 'rgba(168,162,158,.6)'};--o:${a.o};--drift:${a.drift}px;animation:ashRise ${a.dur}s linear ${a.delay}s infinite`}
        ></span>
      ))}
    </div>

    <!-- Hero -->
    <header class="hero snap-sec relative flex min-h-screen items-center justify-center overflow-hidden border-b border-white/10 p-12 text-center">
      <!-- Brasas ascendentes (ceniza incandescente) -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        {embers.map((e) => (
          <span
            class="absolute bottom-[-10px] rounded-full [will-change:transform,opacity]"
            style={`left:${e.left}%;width:${e.size}px;height:${e.size}px;background:${e.warm ? '#ff8c3b' : '#eb5e28'};box-shadow:0 0 ${(e.size * 3).toFixed(1)}px ${e.warm ? 'rgba(255,110,40,.8)' : 'rgba(235,94,40,.8)'};--sway:${e.sway}px;animation:emberRise ${e.dur}s linear ${e.delay}s infinite`}
          ></span>
        ))}
      </div>

      <div class="rvl flex flex-col items-center gap-5">
        <span class="font-mono text-[11px] uppercase tracking-[.5em] text-ink-muted">M41 · Era Indomitus</span>
        <img
          src="/images/home/warhammer-logo.png"
          alt="Warhammer 40.000"
          class="-my-[120px] h-auto w-[min(720px,80vw)]"
          style="animation:glitchJolt 7s steps(1,end) 3s infinite"
        />
        <div class="flex flex-col items-center gap-4">
          <span class="h-px w-24 bg-secondary/60"></span>
          <p class="m-0 text-center font-display text-[26px] uppercase leading-loose tracking-[.34em] text-secondary">
            En el sombrío futuro del lejano milenio,<br />solo hay guerra
          </p>
          <span class="h-px w-24 bg-secondary/60"></span>
        </div>
      </div>

      <!-- Glitch de pantalla: scanlines CRT + línea de barrido -->
      <div
        class="pointer-events-none absolute inset-0 z-[3] opacity-[.07]"
        style="animation:flicker .18s steps(2) infinite;background:repeating-linear-gradient(to bottom,rgba(255,255,255,.5) 0px,rgba(255,255,255,.5) 1px,transparent 1px,transparent 4px)"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 z-[3] h-[2px]"
        style="background:linear-gradient(90deg,transparent,rgba(235,94,40,.5),rgba(255,255,255,.35),rgba(235,94,40,.5),transparent);animation:sweepLine 9s linear 2s infinite"
      ></div>
    </header>

    <!-- Introducción -->
    <section class="snap-sec flex min-h-screen items-center justify-center border-b border-white/10 p-12">
      <div class="rvl flex max-w-[880px] flex-col gap-9 text-center">
        <span class="intro-line font-mono text-[11px] uppercase tracking-[.5em] text-secondary">✠ El milenio oscuro ✠</span>
        <p class="intro-line m-0 font-display text-[clamp(26px,3.2vw,40px)] font-medium leading-normal text-white [text-wrap:balance]">
          Adéntrate en el extenso universo de <em class="not-italic text-secondary">Warhammer 40.000</em>: un millón de
          mundos, imperios alienígenas y los poderes oscuros de la disformidad esperan a ser descubiertos.
        </p>
        <p class="intro-line m-0 max-w-[620px] self-center text-base leading-[1.9] text-ink-muted [text-wrap:pretty]">
          Tanto si es tu primera incursión en el 41º milenio como si eres un veterano de mil batallas, aquí encontrarás
          la historia, las facciones y los héroes que dan forma a la galaxia más sombría jamás imaginada.
        </p>
      </div>
    </section>

    <!-- Facciones -->
    <section id="facciones" class="snap-sec flex min-h-screen items-center justify-center p-12">
      <div class="w-full max-w-[1800px]">
        <h2 class="rvl m-0 mb-14 text-center font-display text-[34px] font-bold uppercase tracking-[.28em] text-white">
          Facciones
        </h2>
        <div class="faction-row rvl rvl-d1 flex justify-center">
          {factions.map((f) => (
            <a
              href="#"
              class="relative -mr-14 block h-[clamp(520px,78vh,760px)] bg-[#141311] no-underline [clip-path:polygon(76px_0,100%_0,calc(100%_-_76px)_100%,0_100%)] last:mr-0"
            >
              <span
                class={`fbg absolute inset-0 ${f.zoom ? 'fbg-zoom' : ''}`}
                style={`background:url('${f.image}') ${f.pos}/cover no-repeat;transform-origin:${f.origin ?? 'center'}`}
              ></span>
              <span class="absolute inset-x-0 bottom-0 h-60 bg-gradient-to-t from-black/[.92] to-transparent"></span>
              <span class="absolute inset-x-0 bottom-14 flex flex-col items-center gap-3">
                <span class="font-display text-3xl font-bold uppercase tracking-[.24em] text-white">{f.name}</span>
                <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-ink-muted">Ver facción →</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Mapa galáctico -->
    <section class="snap-sec relative h-screen border-t border-white/10">
      <GalaxyMap mode="embed" />
    </section>

    <footer class="border-t border-white/10 px-12 py-10 text-center">
      <span class="font-mono text-[10px] uppercase tracking-[.24em] text-ink-faint">El Emperador protege · M41</span>
    </footer>
  </main>
</Layout>

<style is:global>
  html {
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
  }
  /* El Layout centra el body con flex; esta página es más alta que el viewport */
  body.flex {
    display: block;
  }
  .snap-sec {
    scroll-snap-align: start;
  }

  .hero {
    background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(235, 94, 40, 0.14), transparent 70%), #000;
  }

  .rvl {
    opacity: 0;
    transform: translateY(36px);
    transition:
      opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rvl.in {
    opacity: 1;
    transform: translateY(0);
  }
  .rvl-d1 {
    transition-delay: 0.15s;
  }

  .intro-line {
    display: block;
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition:
      opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rvl.in .intro-line {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  .rvl.in .intro-line:nth-child(1) {
    transition-delay: 0.1s;
  }
  .rvl.in .intro-line:nth-child(2) {
    transition-delay: 0.45s;
  }
  .rvl.in .intro-line:nth-child(3) {
    transition-delay: 0.8s;
  }

  .faction-row > a {
    flex: 1 1 0%;
    transition: flex 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faction-row:hover > a {
    flex: 0.65 1 0%;
  }
  .faction-row > a:hover {
    flex: 1.7 1 0%;
  }
  /* Las imágenes apaisadas quedan limitadas por la altura de la card, así que la expansión
     del flex no las amplía; este scale replica el 1.7x que la vertical (Imperium) obtiene
     de forma natural del cover al crecer el ancho */
  .fbg-zoom {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faction-row > a:hover .fbg-zoom {
    transform: scale(1.7);
  }

  /* Efectos importados del diseño "Hero Cruzada": brasas y glitch de pantalla */
  @keyframes emberRise {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    100% {
      transform: translateY(-110vh) translateX(var(--sway, 40px)) scale(0.2);
      opacity: 0;
    }
  }
  @keyframes glitchJolt {
    0%, 91%, 100% {
      transform: translate(0, 0) skewX(0);
      opacity: 1;
      filter: none;
    }
    92% {
      transform: translate(-6px, 2px) skewX(-4deg);
      opacity: 0.7;
    }
    93% {
      transform: translate(5px, -2px) skewX(3deg);
      opacity: 1;
      filter: hue-rotate(40deg);
    }
    94% {
      transform: translate(-3px, 0) skewX(-2deg);
      opacity: 0.85;
    }
    95% {
      transform: translate(0, 0) skewX(0);
      opacity: 1;
      filter: none;
    }
  }
  @keyframes sweepLine {
    0% {
      top: -4%;
      opacity: 0;
    }
    4% {
      opacity: 0.5;
    }
    18% {
      top: 104%;
      opacity: 0;
    }
    100% {
      top: 104%;
      opacity: 0;
    }
  }
  @keyframes flicker {
    0%, 100% {
      opacity: 0.05;
    }
    50% {
      opacity: 0.09;
    }
  }

  @keyframes ashRise {
    0% {
      transform: translateY(105vh) translateX(0);
      opacity: 0;
    }
    8% {
      opacity: var(--o, 0.3);
    }
    92% {
      opacity: var(--o, 0.3);
    }
    100% {
      transform: translateY(-6vh) translateX(var(--drift, 40px));
      opacity: 0;
    }
  }
  @keyframes starTwinkle {
    0%,
    100% {
      opacity: var(--o, 0.5);
    }
    50% {
      opacity: 0.08;
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in')
          io.unobserve(e.target)
        }
      }
    },
    { threshold: 0.15 }
  )
  document.querySelectorAll('.rvl').forEach((el) => {
    const r = el.getBoundingClientRect()
    if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('in')
    else io.observe(el)
  })
</script>
