---
import Layout from '../layouts/Layout.astro'
import GalaxyMap from '../components/GalaxyMap.astro'
---
<Layout>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

  <div style="position:fixed;inset:0">
    <GalaxyMap mode="page" />
  </div>
</Layout>

<style is:global>
  /* Página a pantalla completa: anula el centrado flex y el height fijo del Layout */
  body:has(#gm-root) { display: block; height: auto; overflow: hidden }
</style>
