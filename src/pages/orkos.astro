---
// Orkos: página por klanes con el arte y las cabeceras del códex (10ª ed., ES),
// construida con el design system del sitio (Cinzel, tokens surface/ink/secondary,
// cards diagonales de /facciones, paneles tipo Card). Sección de Ghazghkull,
// lore por klan con cabecera del códex, galería, personajes y colores, y un
// WAAAGH!-metro (barra de progreso de scroll) al pie.
import Layout from '../layouts/Layout.astro'

const IMG = '/images/orkos/'

const CLANS = [
  {
    id: 'goff', name: 'Klan Goff', en: 'Goffs', sub: 'Los más grandes y los más brutos', tint: '#d8d8d8', ink: '#111', pattern: 'checks',
    banner: IMG + 'goff-banner.webp', image: IMG + 'goff-2.webp', pos: '60% 40%', gallery: [IMG + 'goff-1.webp', IMG + 'goff-2.webp'],
    thing: 'El cuerpo a cuerpo. Llegar el primero y pegar más fuerte que nadie.',
    chars: ['Ghazghkull Mag Uruk Thraka, la Bestia de Armageddon', 'Makari, el portaestandarte de Ghazghkull', 'Los Kamorros con armadura mega'],
    colors: [['Negro Abaddon', '#111111'], ['Cuadros blancos', '#d8d8d8'], ['Rojo Mephiston', '#b3262b'], ['Piel Waaagh! Flesh', '#3f6b2a']],
    lore: [
      'Los Goffs son orkos en estado puro: no les interesan los kamiones ni los kañones raros, solo llegar el primero al cuerpo a cuerpo y pegar más fuerte que nadie. Son los más numerosos, los más grandes y los que más presumen de ello.',
      'Visten de negro con cuadros blancos y negros porque «los colores chillones son para pijos». De sus filas salió Ghazghkull Thraka, el profeta de Gork y Mork, que ha convertido su Waaagh! en la mayor que ha visto la galaxia en diez mil años.',
    ],
  },
  {
    id: 'zol-malvado', name: 'Zol Malvado', en: 'Evil Sunz', sub: 'Los más veloces de la galaxia', tint: '#e0382a', ink: '#fff', pattern: 'flames',
    banner: IMG + 'zol-banner.webp', image: IMG + 'zol-1.webp', pos: '50% 55%', gallery: [IMG + 'zol-1.webp', IMG + 'zol-2.webp'],
    thing: 'Kamiones, motos, karros de guerra y cualquier cosa con motor.',
    chars: ['Los Speed Freeks, el kulto de la velocidad (muchos son Zol Malvado)', 'Wazdakka Gutsmek, el kaudillo motorista', 'Los Moteros y los Kamiones de Guerra'],
    colors: [['Rojo Evil Sunz', '#c8261e'], ['Amarillo llama', '#ffb300'], ['Metal Leadbelcher', '#8f8f93'], ['Negro', '#111111']],
    lore: [
      'Si tiene ruedas, cohetes o hélices, un Zol Malvado ya se ha subido encima. Este klan vive por la velocidad: sus mekánikos trucan los motores hasta que explotan y sus chikos consideran que llegar a la batalla sin marearse es de cobardes.',
      'Son la cantera de los Speed Freeks, el kulto de orkos de cualquier klan que viven por la velocidad y cuyo grito es «¡el rojo va más rápido!». Como los Zol Malvado ya lo pintan todo de rojo, se sienten en casa — y, como creen en ello tan fuerte, resulta que es verdad.',
    ],
  },
  {
    id: 'lunaz-malaz', name: 'Lunaz Malaz', en: 'Bad Moons', sub: 'Los más ricos y los más ruidosos', tint: '#f2c21b', ink: '#111', pattern: 'moons',
    banner: null, image: IMG + 'lunaz-1.webp', pos: '50% 30%', gallery: [IMG + 'lunaz-1.webp'],
    thing: 'Dakka. Mucho dakka. Nunca hay suficiente dakka.',
    chars: ['Nazdreg Ug Urdgrub, el kaudillo más rico de la galaxia', 'Los Lootas y los Kañoneros', 'Los Mekánikos de la Dakka'],
    colors: [['Amarillo Averland', '#f2c21b'], ['Negro', '#111111'], ['Rojo llama', '#c8261e'], ['Metal', '#8f8f93']],
    lore: [
      'A los Lunaz Malaz los dientes les crecen más rápido que a los demás orkos, y como los dientes son la moneda de los orkos, son asquerosamente ricos. Eso compra las armas más grandes, los trajes más chillones y los mekánikos más locos.',
      'Los otros klanes los tachan de blandos, pero nadie dice eso cerca de una brigada Lunaz Malaz con akribilladoras: el volumen de fuego ahoga cualquier opinión.',
    ],
  },
  {
    id: 'kraneo-de-muerte', name: 'Kráneo de Muerte', en: 'Deathskulls', sub: 'Saqueadores con suerte', tint: '#3b7bd4', ink: '#fff', pattern: 'skulls',
    banner: IMG + 'kraneo-banner.webp', image: IMG + 'kraneo-1.webp', pos: '50% 40%', gallery: [IMG + 'kraneo-1.webp'],
    thing: 'Robar cualquier cosa que no esté clavada al suelo (y las clavadas, también).',
    chars: ['Los Mekánikos chatarreros y sus Mega-Dreadz', 'Los Lootas', 'Los Gretchins de suerte'],
    colors: [['Azul Kantor', '#2b4fa0'], ['Azul claro', '#3b7bd4'], ['Metal oxidado', '#6b5a48'], ['Blanco calavera', '#d8d8d8']],
    lore: [
      'Los Kráneo de Muerte roban. Roban a los enemigos, roban a los otros klanes y se roban entre ellos. Sus mekánikos son capaces de montar un karro de guerra con piezas de cuatro ejércitos distintos — y de que, contra toda lógica, funcione.',
      'Se pintan de azul porque el azul da suerte, y su suerte es legendaria: siempre cae en sus manos el trofeo más gordo y siempre sobrevive el que nadie esperaba.',
    ],
  },
  {
    id: 'hacha-zangrienta', name: 'Hacha Zangrienta', en: 'Blood Axes', sub: 'Demasiado listos para ser de fiar', tint: '#6b7d3c', ink: '#fff', pattern: 'camo',
    banner: IMG + 'hacha-banner.webp', image: IMG + 'hacha-1.webp', pos: '50% 45%', gallery: [IMG + 'hacha-1.webp'],
    thing: '"Táktika": emboscadas, kamuflaje y retiradas que nadie entiende.',
    chars: ['Los Komandos', 'Boss Snikrot, el terror de Armageddon', 'Los Kaudillos mercenarios'],
    colors: [['Verde camuflaje', '#6b7d3c'], ['Verde oscuro', '#3f4a24'], ['Marrón', '#5b4a2e'], ['Rojo hacha', '#b3262b']],
    lore: [
      'Los Hacha Zangrienta han aprendido de los humanos: usan camuflaje, planifican, se retiran para volver a atacar e incluso, ocasionalmente, negocian. Para el resto de los orkos esto es sospechoso en el mejor de los casos y directamente traicionero en el peor.',
      'Pero nadie puede negar que funciona. Sus komandos se cuelan donde nadie espera a un orko y sus kaudillos ganan batallas que los demás perderían a lo grande.',
    ],
  },
  {
    id: 'mordedura-de-serpiente', name: 'Mordedura de Serpiente', en: 'Snakebites', sub: 'Salvajes de la vieja escuela', tint: '#8a5a2b', ink: '#fff', pattern: 'tusks',
    banner: null, image: IMG + 'serpiente-1.webp', pos: '55% 40%', gallery: [IMG + 'serpiente-1.webp', IMG + 'serpiente-2.webp'],
    thing: 'Squigs, jabalís de guerra, garrapatos y tradición.',
    chars: ['Los Criadores de bestias y sus Squigs', 'Los Jinetes de Jabalí', 'Los Raroz chamanes'],
    colors: [['Marrón Mournfang', '#8a5a2b'], ['Hueso', '#d9cfae'], ['Verde piel', '#3f6b2a'], ['Rojo tribal', '#b3262b']],
    lore: [
      'Los Mordedura de Serpiente desconfían de la tecnología nueva: montan jabalís, domestican squigs y llevan tatuajes y huesos en lugar de placas de metal. Son los más conservadores de los klanes y se consideran los únicos orkos «de verdad».',
      'Su fuerza bruta no es menor que la de los Goffs, y sus criadores traen a la batalla bestias que la ciencia del Imperio ni siquiera ha catalogado.',
    ],
  },
  {
    id: 'piratas', name: 'Piratas', en: 'Freebooterz', sub: 'Corsarios del vacío', tint: '#2c9e8c', ink: '#fff', pattern: 'bones',
    banner: null, image: null, gallery: [],
    thing: 'Saqueo a sueldo y flotas de pecios espaciales.',
    chars: ['Kaptin Badrukk y sus Flash Gitz', 'Los Kapitanes de los pecios', 'Los loros-squig'],
    colors: [['Lo que roban', '#2c9e8c'], ['Oro del botín', '#f2c21b'], ['Negro pirata', '#111111'], ['Rojo', '#b3262b']],
    lore: [
      'Orkos expulsados de su klan o simplemente aburridos de él, unidos bajo kapitanes piratas que venden su dakka al mejor postor. Sus flotas de pecios remendados aparecen de la nada, arrasan y se marchan cargados de botín.',
      'No tienen color propio: llevan lo que roban, con preferencia por sombreros enormes, loros-squig y más armas de las que un orko puede sostener.',
    ],
  },
]

const FONT = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;900&display=swap'
---
<Layout>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONT} />
    <title>Orkos · Klanes — Rubicón Primaris</title>
  </Fragment>

  <main class="ork relative min-h-screen w-full overflow-x-clip bg-surface font-sans text-white">
    <nav class="relative z-10 flex items-center justify-between border-b border-white/10 px-8 py-5 text-[11px] uppercase tracking-[.2em]">
      <a href="/facciones/xenos#orkos" class="text-ink-muted no-underline transition-colors hover:text-white">← Xenos</a>
      <div class="flex gap-6">
        <a href="/quiz/orkos" class="text-ink-muted no-underline transition-colors hover:text-white">Prueba del saber</a>
        <a href="/" class="text-ink-muted no-underline transition-colors hover:text-white">Portada</a>
      </div>
    </nav>

    <!-- Cabecera: batalla de fondo y símbolo orko -->
    <section class="relative overflow-hidden px-8 pb-16 pt-24 text-center">
      <div class="hero-bg absolute inset-0" style={`background:url('${IMG}hacha-1.webp') center 35%/cover no-repeat`}></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/70 to-surface"></div>
      <img src={IMG + 'simbolo.webp'} alt="" class="hero-sym pointer-events-none absolute left-1/2 top-1/2 w-[min(60vw,460px)] -translate-x-1/2 -translate-y-1/2" aria-hidden="true" />
      <span class="relative z-10 font-mono text-[11px] uppercase tracking-[.5em] text-secondary">✠ Xenos · Los Klanes ✠</span>
      <h1 class="relative z-10 m-0 mt-6 font-display text-[clamp(38px,5vw,64px)] font-bold uppercase tracking-[.18em]">Orkos</h1>
      <p class="relative z-10 m-0 mt-3 font-display text-[clamp(14px,1.3vw,18px)] font-semibold uppercase tracking-[.32em] text-ink-muted">¡Waaagh!</p>
      <div class="relative z-10 mx-auto mt-8 flex max-w-[760px] flex-col gap-5">
        <p class="m-0 text-base leading-[1.9] text-ink-muted [text-wrap:pretty]">
          Los orkos son la especie más extendida de la galaxia y la más feliz: nacen de esporas, crecen peleando y mueren riéndose. No tienen imperio ni doctrina. Tienen kaudillos, y cuando uno crece lo bastante, el campo psíquico colectivo de millones de orkos estalla en una <strong class="font-semibold text-white">Waaagh!</strong> que arrastra sistemas enteros.
        </p>
        <p class="m-0 text-base leading-[1.9] text-ink-muted [text-wrap:pretty]">
          Cada orko pertenece a un <strong class="font-semibold text-white">klan</strong>: una cultura con sus colores, sus manías y su forma favorita de pegar. Se odian entre ellos con cariño — hasta que alguien como Ghazghkull Thraka los mete a todos en la misma Waaagh! y apunta a Armageddon.
        </p>
      </div>
    </section>

    <!-- Cards de klan (estilo Facciones) -->
    <section class="px-8 pb-24">
      <div class="mx-auto max-w-[1600px]">
        <div class="fcard-row">
          {CLANS.map((c) => (
            <a href={`#${c.id}`} class={`fcard pat-${c.pattern}`} data-clan={c.id} style={`--tint:${c.tint};--ink:${c.ink}`}>
              <span class="fbg" style={c.image ? `background:url('${c.image}') ${c.pos || 'center'}/cover no-repeat #141311` : ''}></span>
              <span class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black/[.92] to-transparent"></span>
              <span class="absolute inset-x-0 bottom-9 flex flex-col items-center gap-2 px-10">
                <span class="text-center font-display text-[clamp(15px,1.3vw,21px)] font-bold uppercase tracking-[.16em] leading-tight text-white">{c.name}</span>
                <span class="text-center text-[10.5px] font-semibold uppercase tracking-[.16em] text-ink-muted">{c.en}</span>
              </span>
              <span class="dakka" aria-hidden="true">¡Dakka!</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Ghazghkull -->
    <section class="relative overflow-hidden border-t border-white/10">
      <img src={IMG + 'ghazghkull-banner.webp'} alt="Ghazghkull Thraka" class="block h-[clamp(120px,18vw,260px)] w-full object-cover object-center" />
      <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-12 px-8 py-16 md:flex-row">
        <img src={IMG + 'ghazghkull.webp'} alt="Ghazghkull Mag Uruk Thraka" class="w-full max-w-[420px] shrink-0 rounded-lg border border-white/10" loading="lazy" />
        <div class="max-w-[640px]">
          <span class="font-mono text-[11px] uppercase tracking-[.4em] text-secondary">El profeta de Gork y Mork</span>
          <h2 class="m-0 mt-4 font-display text-[clamp(30px,3.6vw,48px)] font-bold uppercase tracking-[.1em] text-white">Ghazghkull Thraka</h2>
          <p class="m-0 mt-2 font-display text-[13px] font-semibold uppercase tracking-[.3em] text-ink-muted">La Bestia de Armageddon</p>
          <span class="mt-6 block h-px w-24" style="background:linear-gradient(90deg,#d8d8d8,transparent)"></span>
          <div class="mt-6 flex flex-col gap-5">
            <p class="m-0 text-[15px] leading-[1.9] text-ink-muted [text-wrap:pretty]">Un Goff corriente hasta que un disparo en la cabeza y una placa de adamantio cosida al cráneo por un matasanos le abrieron la mente: desde entonces oye a Gork y Mork, y los orkos le creen. Dos veces ha lanzado su Waaagh! contra Armageddon y dos veces el Imperio ha necesitado a sus mejores héroes para sobrevivir.</p>
            <p class="m-0 text-[15px] leading-[1.9] text-ink-muted [text-wrap:pretty]">Hoy es el kaudillo más grande de la galaxia, en todos los sentidos: su Gran Waaagh! arrastra a klanes que jamás habían marchado juntos, y su único rival digno, el comisario Yarrick, fue dejado con vida solo porque a Ghazghkull le divierte.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            {['Klan Goff', 'Armadura mega', 'Waaagh! Ghazghkull', 'Armageddon', 'Golgotha'].map((t) => (
              <span class="inline-flex items-center rounded-full border border-white/15 bg-surface-overlay px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-ink-muted">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Lore del klan seleccionado -->
    <section id="lore" class="relative min-h-[70vh] overflow-hidden border-t border-white/10">
      {CLANS.map((c) => (
        <div class={`lore-bg pat-${c.pattern} absolute inset-0 opacity-0 transition-opacity duration-700`} data-bg={c.id} style={`--tint:${c.tint};--ink:${c.ink}`}></div>
      ))}
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/[.92] via-black/80 to-black/60"></div>
      <div class="relative z-10">
        {CLANS.map((c) => (
          <article class="lore-item" data-lore={c.id} hidden>
            {c.banner
              ? <img src={c.banner} alt={c.name} class="block h-[clamp(110px,16vw,230px)] w-full object-cover object-center" loading="lazy" />
              : <div class={`pat-${c.pattern} h-[clamp(90px,12vw,160px)] w-full`} style={`--tint:${c.tint};--ink:${c.ink}`}></div>}
            <div class="mx-auto flex max-w-[1300px] flex-col items-start gap-12 px-8 py-16 md:flex-row">
              <div class="min-w-0 max-w-[660px] flex-1">
                <span class="font-mono text-[11px] uppercase tracking-[.4em]" style={`color:${c.tint}`}>{c.en} · {c.sub}</span>
                <h2 class="m-0 mt-4 font-display text-[clamp(30px,3.6vw,48px)] font-bold uppercase tracking-[.1em] text-white">{c.name}</h2>
                <span class="mt-6 block h-px w-24" style={`background:linear-gradient(90deg,${c.tint},transparent)`}></span>
                <p class="mt-5 font-mono text-[10px] uppercase tracking-[.22em] text-ink-faint">Lo suyo: {c.thing}</p>
                <div class="mt-6 flex flex-col gap-5">
                  {c.lore.map((p) => (
                    <p class="m-0 text-[15px] leading-[1.9] text-ink-muted [text-wrap:pretty]">{p}</p>
                  ))}
                </div>
                <div class="mt-10 grid gap-4 sm:grid-cols-2">
                  <div class="rounded-lg border border-white/10 bg-surface-raised px-5 py-4">
                    <span class="font-mono text-[10px] uppercase tracking-[.3em] text-ink-faint">Personajes y unidades</span>
                    <ul class="m-0 mt-3 list-none p-0 text-[13.5px] leading-[1.8] text-ink-muted">
                      {c.chars.map((x) => (<li class="flex gap-3"><span style={`color:${c.tint}`}>◆</span>{x}</li>))}
                    </ul>
                  </div>
                  <div class="rounded-lg border border-white/10 bg-surface-raised px-5 py-4">
                    <span class="font-mono text-[10px] uppercase tracking-[.3em] text-ink-faint">Colores oficiales</span>
                    <ul class="m-0 mt-3 flex list-none flex-wrap gap-3 p-0">
                      {c.colors.map(([name, hex]) => (
                        <li class="flex items-center gap-2 text-[12px] text-ink-muted">
                          <span class="block h-6 w-6 rounded-md border border-white/15" style={`background:${hex}`}></span>{name}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="mt-10 font-mono text-[9px] uppercase tracking-[.24em] text-ink-faint">Archivo Ordo Xenos · Orkos · {c.name} · M42</div>
              </div>
              {c.gallery.length > 0 && (
                <div class="gallery flex w-full shrink-0 gap-4 md:w-auto md:flex-col" style={`--tint:${c.tint}`}>
                  {c.gallery.map((src, i) => (
                    <figure class="m-0"><img src={src} alt={`${c.name} · ${i + 1}`} loading="lazy" /></figure>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- WAAAGH!-metro -->
    <div class="meter" aria-hidden="true">
      <span class="meter-label">WAAAGH!</span>
      <span class="meter-bar"><span class="meter-fill"></span></span>
      <span class="meter-pct">0%</span>
    </div>

    <footer class="border-t border-white/10 px-12 py-10 pb-24 text-center">
      <span class="font-mono text-[10px] uppercase tracking-[.24em] text-ink-faint">¡Gork y Mork os miran! · M42</span>
    </footer>
  </main>
</Layout>

<style is:global>
  body.flex { display: block; }
  html { scroll-behavior: smooth; }

  .hero-bg { filter: saturate(0.7) brightness(0.5); }
  .hero-sym { opacity: 0.16; mix-blend-mode: screen; }

  /* Cards diagonales (mismo componente visual que /facciones) */
  .fcard {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
  }
  .fcard .fbg {
    position: absolute; inset: 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
    filter: saturate(0.85);
  }
  .fcard:hover .fbg, .fcard.on .fbg { transform: scale(1.06); filter: saturate(1.05); }
  .fcard.on { box-shadow: inset 0 -3px 0 var(--tint); }
  .fcard-row { display: flex; justify-content: center; }
  .fcard-row .fcard {
    flex: 1 1 0%;
    margin-right: -48px;
    height: clamp(280px, 40vh, 380px);
    clip-path: polygon(56px 0, 100% 0, calc(100% - 56px) 100%, 0 100%);
    transition: flex 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fcard-row .fcard:last-child { margin-right: 0; }
  .fcard-row:hover .fcard { flex: 0.75 1 0%; }
  .fcard-row .fcard:hover { flex: 1.5 1 0%; }
  /* Guiño orko: "¡Dakka!" parpadea al hover, en la tipografía del sitio */
  .fcard .dakka {
    position: absolute; top: 22px; right: 70px;
    font-family: 'Cinzel', serif; font-weight: 900; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--tint); opacity: 0; pointer-events: none;
  }
  .fcard:hover .dakka { animation: dakka 1.1s steps(1) infinite; }
  @keyframes dakka { 0%, 70% { opacity: 0; } 72%, 80% { opacity: 1; } 82%, 100% { opacity: 0; } }

  /* Patrones por klan: fondo de card sin imagen y fondo de la sección de lore */
  .fcard.pat-bones .fbg:not([style*="url"]) {
    background:
      repeating-linear-gradient(90deg, transparent 0 30px, rgba(255,255,255,0.10) 30px 34px),
      repeating-linear-gradient(0deg, transparent 0 30px, rgba(255,255,255,0.10) 30px 34px),
      radial-gradient(90% 70% at 50% 28%, color-mix(in srgb, var(--tint) 35%, transparent), transparent 72%),
      #141311;
  }
  .pat-checks.lore-bg, div.pat-checks { background: repeating-conic-gradient(var(--tint) 0 25%, #111 0 50%) 0 0 / 44px 44px; }
  .pat-flames.lore-bg, div.pat-flames {
    background:
      radial-gradient(80px 140px at 20% 110%, #ffb300, transparent 70%),
      radial-gradient(120px 200px at 50% 120%, #ff6a00, transparent 70%),
      radial-gradient(80px 140px at 80% 110%, #ffb300, transparent 70%),
      var(--tint);
  }
  .pat-moons.lore-bg, div.pat-moons { background: radial-gradient(circle at 30% 30%, #1a1a1a 22px, var(--tint) 23px) 0 0 / 70px 70px; }
  .pat-skulls.lore-bg, div.pat-skulls {
    background:
      radial-gradient(circle at 50% 40%, rgba(255,255,255,0.22) 10px, transparent 11px) 0 0 / 60px 60px,
      repeating-linear-gradient(45deg, transparent 0 18px, rgba(0,0,0,0.18) 18px 20px),
      var(--tint);
  }
  .pat-camo.lore-bg, div.pat-camo {
    background:
      radial-gradient(ellipse 60px 35px at 20% 25%, #3f4a24 98%, transparent),
      radial-gradient(ellipse 70px 40px at 75% 60%, #2a2f19 98%, transparent),
      radial-gradient(ellipse 50px 30px at 40% 80%, #8a8f5c 98%, transparent),
      radial-gradient(ellipse 60px 35px at 85% 15%, #5b6638 98%, transparent),
      var(--tint);
  }
  .pat-tusks.lore-bg, div.pat-tusks {
    background:
      repeating-linear-gradient(-35deg, transparent 0 22px, rgba(255,255,255,0.10) 22px 26px),
      radial-gradient(circle at 50% 50%, rgba(0,0,0,0.35), transparent 70%),
      var(--tint);
  }
  .pat-bones.lore-bg, div.pat-bones {
    background:
      repeating-linear-gradient(90deg, transparent 0 30px, rgba(255,255,255,0.12) 30px 34px),
      repeating-linear-gradient(0deg, transparent 0 30px, rgba(255,255,255,0.12) 30px 34px),
      var(--tint);
  }
  .lore-bg { filter: saturate(0.7) brightness(0.35); }
  .lore-bg.on { opacity: 1; }
  .lore-item[hidden] { display: none; }

  .gallery figure {
    width: 260px;
    border: 1px solid color-mix(in srgb, var(--tint) 45%, transparent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--tint) 25%, transparent);
    background: #000;
  }
  .gallery img { display: block; width: 100%; height: 220px; object-fit: cover; filter: saturate(0.9); transition: filter 0.4s ease; }
  .gallery figure:hover img { filter: saturate(1.05) brightness(1.05); }
  @media (max-width: 767px) { .gallery figure { flex: 1; width: auto; } .gallery img { height: 180px; } }

  /* WAAAGH!-metro: barra de progreso con los tokens del sitio */
  .meter {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: flex; align-items: center; gap: 14px; padding: 10px 18px;
    background: linear-gradient(180deg, rgba(0,0,0,0.6), #000);
    border-top: 1px solid rgba(255,255,255,0.1);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase;
  }
  .meter-label { color: #eb5e28; }
  .meter-pct { color: #fff; min-width: 44px; text-align: right; }
  .meter-bar { flex: 1; height: 6px; background: #161513; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; }
  .meter-fill { display: block; height: 100%; width: 0%; background: #eb5e28; transition: width 0.15s linear; }
  .meter.full .meter-label { text-shadow: 0 0 12px #eb5e28; }

  @media (max-width: 860px) {
    .fcard-row { flex-direction: column; gap: 14px; }
    .fcard-row .fcard { height: 150px; margin-right: 0; clip-path: polygon(36px 0, 100% 0, calc(100% - 36px) 100%, 0 100%); }
    .fcard-row:hover .fcard, .fcard-row .fcard:hover { flex: 1 1 0%; }
  }
</style>

<script>
  const items = [...document.querySelectorAll('.lore-item')]
  const bgs = [...document.querySelectorAll('.lore-bg')]
  const plates = [...document.querySelectorAll('.fcard')]

  function select (id, opts) {
    if (!items.some((el) => el.dataset.lore === id)) return
    items.forEach((el) => { el.hidden = el.dataset.lore !== id })
    bgs.forEach((el) => el.classList.toggle('on', el.dataset.bg === id))
    plates.forEach((el) => el.classList.toggle('on', el.dataset.clan === id))
    if (opts && opts.hash) history.replaceState(null, '', '#' + id)
    if (opts && opts.scroll) document.getElementById('lore').scrollIntoView({ behavior: 'smooth' })
  }
  plates.forEach((p) => p.addEventListener('click', (e) => {
    e.preventDefault()
    select(p.dataset.clan, { hash: true, scroll: true })
  }))
  const initial = location.hash.slice(1)
  if (initial && items.some((el) => el.dataset.lore === initial)) {
    select(initial, { hash: true })
    document.getElementById('lore').scrollIntoView({ behavior: 'instant' })
  } else if (items[0]) select(items[0].dataset.lore)

  const meter = document.querySelector('.meter')
  const fill = document.querySelector('.meter-fill')
  const pct = document.querySelector('.meter-pct')
  function update () {
    const max = document.documentElement.scrollHeight - window.innerHeight
    const p = max > 0 ? Math.min(100, Math.round((window.scrollY / max) * 100)) : 100
    fill.style.width = p + '%'
    pct.textContent = p + '%'
    meter.classList.toggle('full', p >= 100)
  }
  window.addEventListener('scroll', update, { passive: true })
  window.addEventListener('resize', update)
  update()
</script>
