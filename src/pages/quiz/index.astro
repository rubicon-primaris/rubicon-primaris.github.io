---
import Layout from '../../layouts/Layout.astro'

const quizzes = [
  { href: '/quiz/general', icon: null, glyph: '✠', name: 'Prueba General', desc: 'Todo el saber: legiones, caos, mundos y heráldica', tag: 'TODAS LAS CATEGORÍAS' },
  { href: '/quiz/astartes', icon: '/images/legions/icons/13-ultra.png', glyph: null, name: 'Adeptus Astartes', desc: 'Linajes, señores del capítulo y colores de heráldica', tag: 'GENEALOGÍA' },
  { href: '/quiz/caos', icon: '/images/legions/icons/16-sons-of-horus.png', glyph: null, name: 'Las Fuerzas del Caos', desc: 'Legiones traidoras, primarcas caídos y bandas renegadas', tag: 'HEREJÍA' },
  { href: '/quiz/galaxia', icon: null, glyph: '✦', name: 'La Galaxia', desc: 'Mundos, facciones y segmentums en la era M42', tag: 'CARTOGRAFÍA' }
]
const proximamente = ['Orkos', 'Necrones', 'Aeldari']
---
<Layout>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

  <div id="qh-root" style="width:100vw;min-height:100vh;background:#080809;color:#e8e6e0;font-family:system-ui,'Segoe UI',sans-serif">
    <header style="text-align:center;padding:56px 24px 20px;display:flex;flex-direction:column;gap:14px;align-items:center">
      <div style="font-size:12px;letter-spacing:0.4em;color:#8a8a92;text-transform:uppercase">Bibliotheca Imperialis</div>
      <h1 style="font-family:'Cinzel',serif;font-weight:700;font-size:clamp(30px,5vw,54px);margin:0;letter-spacing:0.06em;color:#ffffff">PRUEBAS DEL SABER</h1>
      <p style="max-width:600px;margin:0;color:#a8a8b0;font-size:15px;line-height:1.6;text-wrap:pretty">Demuestra cuánto conoces del Imperio y de sus enemigos. Tres niveles de dificultad, preguntas trampa y rangos que ganar. El Emperador te observa.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a href="/genealogia" class="qh-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">← GENEALOGÍA</a>
        <a href="/mapa" class="qh-hb" style="font-size:12px;letter-spacing:0.2em;text-decoration:none;color:#e8e6e0;border:1px solid #34343c;padding:8px 20px;border-radius:2px">MAPA GALÁCTICO</a>
      </div>
    </header>

    <main style="max-width:980px;margin:0 auto;padding:20px 20px 40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
      {quizzes.map((q) => (
        <a href={q.href} class="qh-card" style="display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;text-decoration:none;color:#e8e6e0;background:#0c0d10;border:1px solid #2e2e36;border-radius:3px;padding:28px 20px">
          {q.icon
            ? <img src={q.icon} alt="" width="54" height="54" style="width:54px;height:54px;object-fit:contain" />
            : <span style="font-size:40px;line-height:54px;color:#ffffff">{q.glyph}</span>}
          <div style="font-size:9px;letter-spacing:0.3em;color:#6a6a72">{q.tag}</div>
          <div style="font-family:'Cinzel',serif;font-size:19px;font-weight:700;color:#ffffff">{q.name}</div>
          <div style="font-size:12.5px;line-height:1.6;color:#a8a8b0;text-wrap:pretty">{q.desc}</div>
          <span style="margin-top:6px;font-size:11px;letter-spacing:0.2em;border:1px solid #34343c;padding:7px 18px;border-radius:2px">COMENZAR →</span>
        </a>
      ))}
      {proximamente.map((n) => (
        <div style="display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;text-align:center;background:#0a0a0c;border:1px dashed #26262c;border-radius:3px;padding:28px 20px;opacity:0.55">
          <span style="font-size:40px;line-height:54px;color:#55555c">?</span>
          <div style="font-family:'Cinzel',serif;font-size:19px;font-weight:700;color:#8a8a92">{n}</div>
          <div style="font-size:11px;letter-spacing:0.2em;color:#55555c">ARCHIVOS EN DESCIFRADO</div>
        </div>
      ))}
    </main>

    <footer style="text-align:center;padding:12px 24px 48px;font-size:11px;color:#55555c;line-height:1.7">
      Pruebas no oficiales creadas por fans.<br />Warhammer 40,000 es propiedad de Games Workshop.
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(#qh-root) { display: block; height: auto }
  #qh-root .qh-hb:hover { border-color: #ffffff !important }
  #qh-root .qh-card { transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease }
  #qh-root .qh-card:hover {
    transform: translateY(-4px); border-color: #c8c6c0 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 14px rgba(255, 255, 255, 0.06);
  }
</style>
